#!/usr/bin/env python3
"""bb-emit — publish a Bloodbank v3 event to NATS from the host.

Dependency-free (stdlib only). Wraps a `data` payload (read from stdin, or --data)
in the 33GOD CloudEvents v1 envelope, derives the NATS subject / domain /
ordering_key / correlationid from --type, and PUBs to NATS on 127.0.0.1:4222 —
the same core subject the bloodbank-event-toaster listens on (bloodbank.evt.>),
so a correct emit fans out to ntfy.delo.sh/bloodbank plus every other consumer.

This is the host-side seed of the future n8n-nodes-bloodbank node: same envelope
construction, same subject binding.

Fail-open by default — a dead bus must never break the calling pipeline. Pass
--strict to exit non-zero on publish failure.

Envelope contract: bloodbank/schemas/_common/cloudevent_base.v1.json
Subject binding : type `bloodbank.<domain>.<entity>.<action>`     (4 tokens)
                  -> subject `bloodbank.evt.<domain>.<entity>.<action>`

There is no contract version token. A 5-token --type whose second token is
NOT a kind marker (the retired `bloodbank.v1.*` shape) is REJECTED outright
rather than rewritten, so a stale caller fails loudly instead of publishing
to a subject nobody binds. The `.v1` in `schemaref` is the schema revision —
a different axis, still live; see docs/event-naming.md §3.1 and §13.

A 5-token --type whose second token IS a kind marker (`bloodbank.evt.…`,
`bloodbank.cmd.…`, `bloodbank.rpy.…`) is a SUBJECT, not a stale type, and is
accepted: the type and the kind are both recoverable from it, unambiguously.
Authors read the subject off docs/event-naming.md, so refusing the string
they are holding taught them nothing. The retired-version guard above is
untouched — `bloodbank.v1.audio.transcription.completed` still fails loudly.

--check is the dry run. It builds and validates the envelope and prints the
type, subject, schemaref, dataschema, ordering_key, correlationid and
causationid that WOULD be published, then exits without touching NATS. This
is the command to run while writing a producer: it answers "is my name legal"
without putting anything on the bus. When a payload is piped in, --check also
holds the whole envelope to its JSON Schema (core.validate.validate_envelope)
and exits 1 if it fails, so a producer proves its data before the real emit.
An empty payload is the name question alone and skips the schema. The publish
path itself stays stdlib-only and fail-open; it is not held to the schema.

Lineage and ordering: causationid is always emitted (null unless --causation
is given -- a root event). ordering_key is --ordering-key when given, else the
narrowest §11.1 bucket the payload names: transcription:<id> when the data
carries a transcription_id/id, project:<data.project.slug> for the project
domain, else <domain>:<uuid4>.

Every event envelope carries an `actor` (§10, and REQUIRED_EVENT_FIELDS in
core/validate.py). bb-emit shipped without one for months: NATS core PUB does
no validation, so the bus accepted the envelopes and Candystore projected them
with `actor IS NULL`, invisible to every `actor->>'cli'` / `actor->>'agent_id'`
read side. A CLI emit is a service acting on its own behalf, so the default is
derived from --service: {"type": "service", "agent_id": "bloodbank.service.<service>"}.
Override with --actor-type / --actor-id, or hand a whole object to --actor.

The envelope is now checked against core/validate.assert_contract before it is
published, when that module is importable (it is stdlib-only, and it is the
same check every other producer answers to). A contract violation is a
caller-side bug, so it exits non-zero regardless of --strict — the same split
that already applies to a malformed --type.

Usage:
  echo '{"transcription_id":"42","file_path":"/x.mp3","transcript_text":""}' \
    | bb-emit --type bloodbank.audio.transcription.completed

  bb-emit --check --type bloodbank.evt.repo.decision.recorded --data '{}'
  bb-emit --check --type bloodbank.project.activity.recorded --correlation <run_id> < data.json
  bb contract            # the legal domains / entities / actions
"""
import argparse
import json
import socket
import sys
import uuid
from datetime import datetime, timezone
from pathlib import Path

# core/validate.py is stdlib-only and lives in the same repo as this script.
# Importing it here is what closes the gap between "bb-emit published it" and
# "the contract accepts it" -- the two used to be different questions. A copy
# of bb-emit that has been lifted out of the repo tree simply skips the check
# rather than failing to start.
_ASSERT_CONTRACT = None
_VALIDATE_ENVELOPE = None
_IMPORT_ERROR = None
_HOOKS_DIR = Path(__file__).resolve().parent.parent / "services" / "agent-hooks"
if _HOOKS_DIR.is_dir():
    if str(_HOOKS_DIR) not in sys.path:
        sys.path.insert(0, str(_HOOKS_DIR))
    try:
        from core.validate import (
            ContractViolation,
            EnvelopeInvalid,
            ValidationUnavailable,
            assert_contract as _ASSERT_CONTRACT,
            validate_envelope as _VALIDATE_ENVELOPE,
        )
    except Exception as _e:  # noqa: BLE001
        # In-repo and still unimportable means validate.py is BROKEN, which is
        # a very different thing from "this copy of bb-emit was lifted out of
        # the tree". Say so on every emit rather than silently degrading to the
        # unvalidated behaviour this flag was added to end.
        _ASSERT_CONTRACT = None
        _VALIDATE_ENVELOPE = None
        _IMPORT_ERROR = _e

# type <-> subject kind markers (§3/§4). Mirrored from core/validate.KIND_MARKERS
# so a lifted-out copy can still compute a subject; asserted equal below when the
# real module is importable, so the two can never drift apart unnoticed.
_KIND_MARKERS = {"event": "evt", "command": "cmd", "reply": "rpy"}
_MARKER_TO_KIND = {v: k for k, v in _KIND_MARKERS.items()}
if _ASSERT_CONTRACT is not None:
    from core.validate import KIND_MARKERS as _CANON_MARKERS
    assert _KIND_MARKERS == dict(_CANON_MARKERS), (
        "bb-emit's mirrored KIND_MARKERS drifted from core/validate.py"
    )

# RFC 4122 URL namespace — deterministic correlationid so started/completed/failed
# for one transcription_id share a causal chain without threading state through n8n.
_NS = uuid.UUID("6ba7b811-9dad-11d1-80b4-00c04fd430c8")


def _rfc3339_now():
    return datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")


def _nats_publish(subject, body, host, port, timeout=3.0):
    with socket.create_connection((host, port), timeout=timeout) as s:
        f = s.makefile("rwb", buffering=0)
        f.readline()  # eat INFO
        f.write(b'CONNECT {"verbose":false,"pedantic":false,"name":"bb-emit","lang":"py-stdlib"}\r\n')
        f.write(b"PUB " + subject.encode() + b" " + str(len(body)).encode() + b"\r\n" + body + b"\r\n")
        f.write(b"PING\r\n")
        f.flush()
        while True:
            line = f.readline()
            if not line:
                raise IOError("NATS closed connection before PONG")
            if line.startswith(b"PONG"):
                return
            if line.startswith(b"-ERR"):
                raise IOError("NATS -ERR: " + line.decode(errors="replace").strip())


def _derive_ordering_key(domain, data, tid):
    """§11.1 bucket when the caller gave none: the narrowest one the payload names."""
    if tid:
        return f"transcription:{tid}"
    if domain == "project" and isinstance(data.get("project"), dict) and data["project"].get("slug"):
        return f"project:{data['project']['slug']}"
    return f"{domain}:{uuid.uuid4()}"


def main():
    ap = argparse.ArgumentParser(description="Publish a Bloodbank v3 event to NATS.")
    ap.add_argument("--type", required=True,
                    help="bloodbank.<domain>.<entity>.<action> (4 tokens), or the "
                         "5-token subject form bloodbank.<evt|cmd|rpy>.<domain>."
                         "<entity>.<action> (kind is then taken from the marker)")
    ap.add_argument("--kind", default=None, choices=["event", "command", "reply"],
                    help="envelope kind (default: event, or the marker in a subject-form --type)")
    ap.add_argument("--check", action="store_true",
                    help="dry run: validate and print the type/subject/schemaref/"
                         "dataschema that WOULD be published, then exit without publishing")
    ap.add_argument("--schema-version", type=int, default=1,
                    help="schema revision N for schemaref/dataschema (§13; default: 1)")
    ap.add_argument("--data", help="data JSON as a string (default: read from stdin)")
    ap.add_argument("--source", default="urn:33god:service:n8n-inbox-transcribe")
    ap.add_argument("--producer", default="n8n")
    ap.add_argument("--service", default="inbox-transcribe")
    ap.add_argument("--correlation", help="explicit correlationid (uuid); default derived from transcription_id")
    ap.add_argument("--causation", help="explicit causationid (uuid); default null = root event")
    ap.add_argument("--ordering-key",
                    help="explicit §11.1 ordering bucket (default derived from data: "
                         "transcription:<id>, project:<data.project.slug>, else <domain>:<uuid4>)")
    ap.add_argument("--actor-type", default="service",
                    help="actor.type archetype: service|operator|scheduler|agent_cli|... (default: service)")
    ap.add_argument("--actor-id",
                    help="actor.agent_id (default: bloodbank.service.<--service>)")
    ap.add_argument("--actor",
                    help="whole actor object as JSON; overrides --actor-type/--actor-id")
    ap.add_argument("--host", default="127.0.0.1")
    ap.add_argument("--port", type=int, default=4222)
    ap.add_argument("--strict", action="store_true",
                    help="exit non-zero on publish/validation failure (default: fail-open)")
    a = ap.parse_args()

    # Fail-open is a policy about the BUS: if NATS is down, a producer should
    # not take its caller down with it. It is not a policy about the caller's
    # own arguments. A malformed --type or unparseable data is the caller's
    # bug, is 100% reproducible, and fixing it is entirely in the caller's
    # hands -- so those always exit non-zero regardless of --strict. Without
    # this split, a shell script that emits a retired 5-token type sees rc=0
    # and reports success while nothing was ever published.
    fail_rc = 1 if a.strict else 0   # bus-boundary failures only
    usage_rc = 1                     # caller-side errors, always loud

    # An interactive operator running --check to ask "is this name legal" has no
    # payload to pipe in; blocking on an empty tty read looked like a hang.
    if a.data is not None:
        raw = a.data
    elif sys.stdin.isatty():
        raw = ""
    else:
        raw = sys.stdin.read()
    try:
        data = json.loads(raw) if raw and raw.strip() else {}
    except json.JSONDecodeError as e:
        print(f"bb-emit: invalid data JSON: {e}", file=sys.stderr)
        return usage_rc
    if not isinstance(data, dict):
        print("bb-emit: data must be a JSON object", file=sys.stderr)
        return usage_rc

    # Resolve (type, kind) from --type, which may be given as either the 4-token
    # type or the 5-token subject. The retired `bloodbank.v1.*` shape is still a
    # hard rejection: only a real kind marker in slot 2 makes a 5-token string a
    # subject rather than a stale versioned type.
    parts = a.type.split(".")
    kind = a.kind or "event"
    if len(parts) == 5 and parts[0] == "bloodbank" and parts[1] in _MARKER_TO_KIND:
        marker_kind = _MARKER_TO_KIND[parts[1]]
        if a.kind is not None and a.kind != marker_kind:
            print(f"bb-emit: --kind {a.kind!r} contradicts the '{parts[1]}' marker in "
                  f"--type '{a.type}' (which means kind={marker_kind!r})", file=sys.stderr)
            return usage_rc
        kind = marker_kind
        ce_type = "bloodbank." + ".".join(parts[2:])
    elif len(parts) == 4 and parts[0] == "bloodbank":
        ce_type = a.type
    else:
        print(f"bb-emit: --type must be bloodbank.<domain>.<entity>.<action> (4 tokens) "
              f"or bloodbank.<evt|cmd|rpy>.<domain>.<entity>.<action> (5 tokens), "
              f"got '{a.type}'", file=sys.stderr)
        return usage_rc

    domain = ce_type.split(".")[1]
    subject = f"bloodbank.{_KIND_MARKERS[kind]}." + ce_type[len("bloodbank."):]

    tid = str(data.get("transcription_id") or data.get("id") or "").strip()
    correlationid = a.correlation or str(uuid.uuid5(_NS, tid or ce_type))

    # §10 actor. The invoking context bb-emit already knows about is --service,
    # so that is what the identifier is built from; `bloodbank.service.<name>`
    # matches what tiller and delonet-daily-report already publish.
    if a.actor is not None:
        try:
            actor = json.loads(a.actor)
        except json.JSONDecodeError as e:
            print(f"bb-emit: invalid --actor JSON: {e}", file=sys.stderr)
            return usage_rc
        if not isinstance(actor, dict):
            print("bb-emit: --actor must be a JSON object", file=sys.stderr)
            return usage_rc
    else:
        actor = {
            "type": a.actor_type,
            "agent_id": a.actor_id or f"bloodbank.service.{a.service}",
            "cli": None,
            "provider": None,
            "model": None,
        }
    for f in ("type", "agent_id"):
        if not actor.get(f):
            print(f"bb-emit: actor.{f} is required and must be non-empty (§10)", file=sys.stderr)
            return usage_rc

    # §13: schemaref and dataschema are the SAME revision in two notations, and
    # they are the only place a version is allowed to appear. bb-emit shipped
    # schemaref alone; a consumer resolving schemas through Apicurio had nothing
    # to resolve, so emit both and keep them derived from one --schema-version.
    schemaref = f"{ce_type}.v{a.schema_version}"
    dataschema = f"apicurio://holyfields/{ce_type}/versions/{a.schema_version}"

    envelope = {
        "specversion": "1.0",
        "id": str(uuid.uuid4()),
        "source": a.source,
        "type": ce_type,
        "subject": subject,
        "time": _rfc3339_now(),
        "datacontenttype": "application/json",
        "correlationid": correlationid,
        "causationid": a.causation,
        "producer": a.producer,
        "service": a.service,
        "domain": domain,
        "schemaref": schemaref,
        "dataschema": dataschema,
        "kind": kind,
        "actor": actor,
        "ordering_key": a.ordering_key or _derive_ordering_key(domain, data, tid),
        "data": data,
    }
    if kind == "command":
        # §11.2 — a command envelope is not a contract-valid event envelope; it
        # carries its own required fields. Without these a --kind command emit
        # would fail assert_contract on a shape bb-emit itself chose.
        command_id = str(uuid.uuid4())
        envelope["command_id"] = command_id
        envelope["idempotency_key"] = str(uuid.uuid5(_NS, f"{ce_type}:{correlationid}"))
        envelope["delivery"] = "single_consumer"

    if _ASSERT_CONTRACT is not None:
        try:
            _ASSERT_CONTRACT(envelope)
        except ContractViolation as e:
            print(f"bb-emit: envelope violates the naming contract: {e}", file=sys.stderr)
            print("bb-emit: run `bb contract` to see the legal domains, entities "
                  "and actions.", file=sys.stderr)
            return usage_rc
    elif _IMPORT_ERROR is not None:
        print(f"bb-emit: WARNING — core/validate.py is present but failed to import "
              f"({_IMPORT_ERROR!r}); publishing UNVALIDATED", file=sys.stderr)

    if a.check:
        # Dry run. Everything above already ran, so a PASS here means the very
        # bytes printed are the ones a real emit would put on the bus.
        #
        # The JSON Schema runs here and only here: the publish path stays
        # stdlib-only and fail-open by contract, so a producer proves its
        # payload with --check before the real emit. An empty payload is the
        # "is this name legal" question and has nothing to hold to a schema.
        if not data:
            schema_note = "skipped (empty payload; pipe the data in to validate it)"
        elif _VALIDATE_ENVELOPE is None:
            schema_note = "no (core/validate.py unavailable)"
        else:
            try:
                _VALIDATE_ENVELOPE(envelope)
                schema_note = "yes (core.validate.validate_envelope)"
            except EnvelopeInvalid as e:
                print(f"bb-emit: envelope fails its JSON Schema: {e}", file=sys.stderr)
                return usage_rc
            except ValidationUnavailable as e:
                schema_note = f"no ({e})"
        print(f"PASS  {ce_type}")
        print(f"  kind        {kind}")
        print(f"  type        {ce_type}")
        print(f"  subject     {subject}")
        print(f"  schemaref   {schemaref}")
        print(f"  dataschema  {dataschema}")
        print(f"  domain      {domain}")
        print(f"  actor       {json.dumps(actor, separators=(',', ':'))}")
        print(f"  ordering_key  {envelope['ordering_key']}")
        print(f"  correlationid {correlationid}")
        print(f"  causationid   {envelope['causationid']}")
        if _ASSERT_CONTRACT is None:
            print("  validated   NO — core/validate.py unavailable")
        else:
            print("  validated   yes (core.validate.assert_contract)")
        print(f"  schema      {schema_note}")
        print("bb-emit: --check, nothing published", file=sys.stderr)
        return 0

    body = json.dumps(envelope, separators=(",", ":")).encode("utf-8")
    try:
        _nats_publish(subject, body, a.host, a.port)
    except Exception as e:  # noqa: BLE001 — fail-open at the bus boundary
        # The message must describe what THIS invocation actually did, because
        # the two modes do opposite things. It used to say "failing open"
        # unconditionally while --strict returned 1 -- so an operator reading
        # logs during a bus outage concluded the event was dropped harmlessly
        # at the exact moment the caller had in fact died.
        if a.strict:
            outcome = "--strict: NOT published, exiting 1 (caller fails too)"
        else:
            outcome = "failing open: NOT published, exiting 0 (caller continues)"
        print(f"bb-emit: publish FAILED ({e}); {outcome}", file=sys.stderr)
        return fail_rc
    print(f"bb-emit: published {ce_type} -> {subject} (corr={correlationid[:8]})", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
