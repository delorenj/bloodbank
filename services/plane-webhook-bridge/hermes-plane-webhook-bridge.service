[Unit]
Description=Plane webhook compatibility relay to n8n
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=HERMES_PLANE_BRIDGE_HOST=0.0.0.0
Environment=HERMES_PLANE_BRIDGE_PORT=8477
Environment=N8N_PLANE_WEBHOOK_URL=http://localhost:5678/webhook/plane
# The env file contains op:// references only. op run resolves them in memory.
ExecStart=%h/.local/bin/op run --env-file=%h/.hermes/plane-webhook-bridge.env -- %h/.hermes/hermes-agent/.venv/bin/python %h/code/33GOD/bloodbank/services/plane-webhook-bridge/plane-webhook-bridge.py
Restart=on-failure
RestartSec=5
StandardOutput=append:%h/.hermes/logs/plane-webhook-bridge.log
StandardError=append:%h/.hermes/logs/plane-webhook-bridge.log

[Install]
WantedBy=default.target
