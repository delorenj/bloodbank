{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/delorenj/.agents/hooks/bb-hook --cli gemini --native SessionStart --deadline 15 --trailer passive",
            "timeout": 16000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/delorenj/.agents/hooks/bb-hook --cli gemini --native SessionEnd --trailer passive",
            "timeout": 4000
          }
        ]
      }
