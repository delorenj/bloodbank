#!/usr/bin/env python3
"""asmctl -- look at the Agent State Machine.

The first thing on this box that can see every agent at once, regardless of
which CLI it is, whether it is in a zellij pane, or whether it is a headless
Hermes PM under systemd.

  asmctl ls              one-shot table
  asmctl watch           live table, repainting
  asmctl log <scope>     the transition log for one agent
  asmctl tail            follow every transition as it happens
  asmctl sweep           one sweep tick (stale / gone); run by the systemd timer
  asmctl agents          every agent process on the box, with pane and board
  asmctl who <board>     who would pick up a ticket on <board> right now, ranked

Stdlib only, like the rest of agent-hooks.
"""
from __future__ import annotations

import os
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from core.resp import Connection  # noqa: E402

URL = (os.environ.get("ASM_REDIS_URL") or os.environ.get("TOOLING_REDIS_URL")
       or os.environ.get("REDIS_URL") or "redis://127.0.0.1:6379")

RESET, DIM, BOLD = "\033[0m", "\033[2m", "\033[1m"
COLOR = {
    "starting":       "\033[36m",   # cyan
    "working":        "\033[32m",   # green
    "tool_running":   "\033[33m",   # yellow
    "delegating":     "\033[35m",   # magenta
    "awaiting_human": "\033[1;33m", # bold amber
    "failed":         "\033[31m",   # red
    "stale":          "\033[1;31m", # bold red  (sweeper, step 2)
    "gone":           "\033[90m",   # grey      (sweeper, step 2)
    "idle":           "\033[90m",
    "unknown":        "\033[90m",   # discovered from /proc, never observed
}


def human_ms(ms: float) -> str:
    s = ms / 1000.0
    if s < 60:
        return f"{s:.0f}s"
    if s < 3600:
        return f"{s / 60:.0f}m{s % 60:02.0f}s"
    return f"{s / 3600:.0f}h{(s % 3600) / 60:02.0f}m"


def rows(conn: Connection) -> list[dict]:
    scopes = conn.command("ZRANGE", "asm:live", "0", "-1")
    out = []
    for scope in scopes or []:
        raw = conn.command("HGETALL", f"asm:a:{scope}")
        if not raw:
            # The hash expired but the index entry survived; the sweeper (step
            # 2) reaps these. Skip rather than render a ghost.
            continue
        h = {raw[i]: raw[i + 1] for i in range(0, len(raw), 2)}
        h["scope"] = scope
        out.append(h)
    return out


def render(conn: Connection) -> str:
    now = time.time() * 1000
    data = rows(conn)
    sweeper = conn.command("GET", "asm:sweeper")

    lines = []
    head = f"{'STATE':<15} {'FOR':>7} {'CLI':<12} {'WHERE':<26} {'PANE':>6} {'BASIS':<10} {'T/S'}"
    lines.append(BOLD + head + RESET)
    lines.append(DIM + "-" * len(head) + RESET)

    if not data:
        lines.append(DIM + "  (no agents seen yet -- fire a hook in any CLI)" + RESET)

    # Observed states first: a discovered-but-never-observed agent is real, but
    # it is the least informative row on the board and there are many of them.
    for h in sorted(data, key=lambda r: (r.get("state") == "unknown",
                                         -float(r.get("since") or 0))):
        state = h.get("state", "?")
        # Without a sweeper, `stale` and `gone` cannot fire, so any row here may
        # be a dead agent frozen at its last known state. Render the whole table
        # as untrusted rather than let it read as live.
        if not sweeper:
            state_color = DIM
        else:
            state_color = COLOR.get(state, DIM)
        since = float(h.get("since") or 0)
        held = human_ms(now - since) if since else "-"
        cwd = h.get("cwd", "")
        where = os.path.basename(cwd.rstrip("/")) or cwd or "-"
        pane = h.get("zellij_pane") or "-"
        basis = h.get("basis", "-")
        ts = f"{h.get('tools', '0')}/{h.get('subs', '0')}"
        lines.append(
            f"{state_color}{state:<15}{RESET} {held:>7} {h.get('cli', '?'):<12} "
            f"{where[:26]:<26} {str(pane):>6} {DIM}{basis:<10}{RESET} {ts}"
        )

    lines.append("")
    observed = sum(1 for h in data if h.get("state") not in ("unknown", None))
    if data:
        lines.append(DIM + f"  {len(data)} agent(s) alive, {observed} with an "
                     f"observed state ({len(data) - observed} discovered only)"
                     + RESET)
    if sweeper:
        lines.append(DIM + f"  sweeper: {sweeper}" + RESET)
    else:
        lines.append(
            "\033[33m  sweeper not running -- `stale` and `gone` will not fire; "
            "rows below may be dead agents.\033[0m"
        )
    return "\n".join(lines)


def main(argv: list[str]) -> int:
    cmd = argv[1] if len(argv) > 1 else "ls"

    if cmd == "ls":
        with Connection(URL) as conn:
            print(render(conn))
        return 0

    if cmd == "watch":
        try:
            while True:
                with Connection(URL) as conn:
                    frame = render(conn)
                sys.stdout.write("\033[H\033[J" + frame + "\n")
                sys.stdout.flush()
                time.sleep(1.0)
        except KeyboardInterrupt:
            return 0

    if cmd == "log":
        if len(argv) < 3:
            print("usage: asmctl log <scope>", file=sys.stderr)
            return 2
        with Connection(URL) as conn:
            entries = conn.command("XRANGE", f"asm:t:{argv[2]}", "-", "+")
        for entry in entries or []:
            fields = entry[1]
            payload = dict(zip(fields[::2], fields[1::2])).get("j", "")
            print(payload)
        return 0

    if cmd in ("agents", "who"):
        import re, subprocess                       # noqa: PLC0415
        from core.agents import discover            # noqa: PLC0415

        board_filter = argv[2] if cmd == "who" and len(argv) > 2 else None
        if cmd == "who" and not board_filter:
            print("usage: asmctl who <board_id|identifier>", file=sys.stderr)
            return 2

        agents = discover()
        with Connection(URL) as conn:
            rows = {}
            for a in agents:
                raw = conn.command("HGETALL", f"asm:a:{a['scope']}")
                if raw:
                    rows[a["scope"]] = {raw[i]: raw[i + 1]
                                        for i in range(0, len(raw), 2)}
            sweeper = conn.command("GET", "asm:sweeper")

        # The focused pane is a BONUS, never a requirement -- unpaned agents
        # must stay eligible. One ~200ms subprocess, cached, never per-candidate.
        focused = ""
        try:
            out = subprocess.run(
                ["zellij", "-s", os.environ.get("ZELLIJ_SESSION_NAME", ""),
                 "action", "list-clients"],
                capture_output=True, text=True, timeout=3.0).stdout
            hit = re.search(r"terminal_(\d+)", out)
            focused = hit.group(1) if hit else ""
        except (OSError, subprocess.SubprocessError):
            pass

        now = time.time() * 1000
        table = []
        for a in agents:
            board = a["board"]
            if board_filter:
                if not board:
                    continue
                if board_filter not in (board["board_id"], board["identifier"]):
                    continue
            row = rows.get(a["scope"], {})
            state = row.get("state", "unknown")
            last = float(row.get("last_ms") or 0)
            age = (now - last) / 1000 if last else None
            busy = any(int(row.get(k) or 0) > 0
                       for k in ("turn", "tools", "subs"))
            # idle already implies turn/tools/subs zero and not blocked -- it
            # sits at the BOTTOM of asm.lua's derive ladder. awaiting_human does
            # NOT: it outranks tools and turn, so it must be checked explicitly.
            claimable = (state == "idle"
                         or (state == "awaiting_human" and not busy))
            table.append({**a, "state": state, "age": age,
                          "claimable": claimable,
                          "focus": a["pane"] and a["pane"] == focused})

        rank = {"idle": 0, "awaiting_human": 1}
        table.sort(key=lambda r: (
            not r["focus"], rank.get(r["state"], 9),
            -(r["age"] is not None and -r["age"] or 0)))

        hdr = (f"{'':1} {'STATE':<15} {'AGE':>7} {'CLI':<8} {'PANE':>5} "
               f"{'BOARD':<8} {'WHERE':<30}")
        print(BOLD + hdr + RESET)
        print(DIM + "-" * len(hdr) + RESET)
        for r in table:
            mark = "*" if r["focus"] else (" " if r["claimable"] else DIM + "·" + RESET)
            color = COLOR.get(r["state"], DIM)
            age = f"{r['age']:.0f}s" if r["age"] is not None else "-"
            board = r["board"]["identifier"] if r["board"] else "-"
            where = os.path.basename(r["cwd"].rstrip("/")) or r["cwd"]
            pane = r["pane"] or "-"
            print(f"{mark} {color}{r['state']:<15}{RESET} {age:>7} {r['cli']:<8} "
                  f"{pane:>5} {board:<8} {where[:30]:<30}")
        print()
        eligible = [r for r in table if r["claimable"]]
        if board_filter:
            if eligible:
                w = eligible[0]
                print(f"  WINNER: {w['cli']} in {os.path.basename(w['cwd'])} "
                      f"(pane {w['pane'] or '-'}, {w['state']})"
                      + ("  [focused]" if w["focus"] else ""))
            else:
                print(DIM + "  no claimable agent -> falls back to the fleet PM"
                      + RESET)
        print(DIM + f"  {len(table)} agent(s), {len(eligible)} claimable"
              + ("" if sweeper else "  (SWEEPER DOWN - states may be stale)")
              + RESET)
        print(DIM + "  * = focused pane   · = not claimable" + RESET)
        return 0

    if cmd == "sweep":
        from core.sweep import run as sweep_run  # noqa: PLC0415

        summary = sweep_run(log=lambda m: print(m, file=sys.stderr))
        for edge in summary["transitions"]:
            print(f"{edge['from']} -> {edge['to']}  {edge['scope']}")
        if os.environ.get("ASM_SWEEP_QUIET") != "1" or summary["transitions"]:
            print(
                f"swept {summary['seen']} agent(s): "
                f"{summary['stale']} stale, {summary['gone']} gone, "
                f"{summary['reaped']} ghost row(s) reaped",
                file=sys.stderr,
            )
        return 1 if summary.get("error") else 0

    if cmd == "tail":
        # SUBSCRIBE holds the connection open; read replies forever.
        conn = Connection(URL, timeout=86400.0)
        conn.command("SUBSCRIBE", "asm:transitions")
        print(DIM + "listening on asm:transitions ..." + RESET, file=sys.stderr)
        try:
            while True:
                msg = conn.read_push()
                if isinstance(msg, list) and len(msg) == 3 and msg[0] == "message":
                    print(msg[2], flush=True)
        except KeyboardInterrupt:
            return 0
        finally:
            conn.close()

    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
