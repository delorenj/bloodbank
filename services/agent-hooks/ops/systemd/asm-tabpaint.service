# Paint the Agent State Machine onto the zellij tab bar.
#
# A pure SURFACE: it reads asm:* and renames tabs. It owns no state, so it can
# be restarted, killed, or run alongside other surfaces (Deckard, the Nanoleaf
# wall) without any of them disagreeing about what an agent is doing.
#
# It does depend on the sweeper for honesty rather than for data: without
# asm-sweep.timer nothing can produce `gone` or `stale`, so dead agents stay
# frozen at their last state and the bar quietly lies.
[Unit]
Description=Paint the 33GOD Agent State Machine onto the zellij tab bar
Documentation=file:%h/code/33GOD/bloodbank/services/agent-hooks/README.md
After=network-online.target

[Service]
# Kill the blink. The painter swaps 🟢 for ⚫ on alternate phases to signal
# "busy", which is a rename of the zellij tab -- and deckard treats every rename
# as a topology change. Measured: 841 renames and 1,090 full deck repaints in ten
# minutes, to serve ONE real agent event. Setting ALT to the same glyph makes
# both phases identical, so `rendered != want` never trips and a steady state
# costs one rename, ever -- exactly what the painter's own comment promises.
#
# Nothing is lost: deckard already animates Active as a slow green breathe and
# Hitl as a sharp amber pulse. Motion is ITS vocabulary; duplicating it in the
# tab name only corrupted its change detection.
Environment=TABPAINT_BLINK_ALT=🟢
Type=simple
ExecStart=/usr/bin/python3 %h/code/33GOD/bloodbank/services/agent-hooks/bin/asm-tabpaint
# Host service on purpose: it drives the zellij CLI, which does not exist in a
# container.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=ZELLIJ_BIN=%h/.local/bin/zellij
Environment=TABPAINT_SESSION=Workspace
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=3
# It strips its own glyphs off every tab on the way out, so give it room to.
TimeoutStopSec=10
Nice=5

[Install]
WantedBy=default.target
