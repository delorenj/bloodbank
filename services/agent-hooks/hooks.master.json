          "matcher": ".*"
        },
        {
          "native": "SubagentStart",
          "role": "invocation_start",
          "arg": "SubagentStart",
          "lifecycle": "agent.invocation.started",
          "payload": "stdin"
        },
        {
          "native": "SubagentStop",
          "role": "subagent_stop",
          "arg": "SubagentStop",
          "lifecycle": "agent.invocation.completed",
          "payload": "stdin"
        },
        {
          "native": "PermissionRequest",
          "role": "attention",
          "arg": "PermissionRequest",
          "publish": false,
          "alert": "attention",
          "attention_kind": "gate",
          "payload": "stdin",
          "timeout": 4
        },
        {
          "native": "SessionEnd",
          "role": "session_end",
          "arg": "SessionEnd",
          "lifecycle": "agent.session.ended",
          "payload": "stdin",
          "timeout": 3
        },
        {
          "native": "Interrupt",
          "role": "turn_completed",
          "arg": "Interrupt",
          "lifecycle": "conversation.turn.completed",
          "payload": "stdin",
          "timeout": 3
        }
      ],
      "support_status": "supported",
      "default_timeout_sec": 4
    },
    "hermes": {
      "label": "Hermes PM agent",
      "dialect": "hermes_config",
      "config_target": "hermes/hooks.config.json",
      "event_map_target": "hermes/event_map.generated.json",
      "publisher": "bb-hook",
      "legacy_publishers": [
        "hermes/publish.py",
        "bloodbank/publish.py"
      ],
      "fleet_registry": "~/.hermes/agents-registry.yaml",
      "runtime_subdir": "runtime",
      "allowlist_filename": "shell-hooks-allowlist.json",
      "runner": "{hooks_dir}/bb-hook --cli hermes --native",
      "default_timeout": 4,
      "note": "Discover default and non-backup profile configs, plus live HERMES_HOME process paths and initialized legacy registry runtimes. Each native event invokes the hub once; hooks_auto_accept or exact allowlist governs native loading.",
      "actor": {
        "type": "agent_cli",
        "agent_id": "bloodbank.agent.hermes",
        "cli": "hermes",
        "provider": null,
        "model": null
      },
      "bindings": [
        {
          "native": "on_session_start",
