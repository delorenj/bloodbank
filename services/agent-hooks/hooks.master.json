{
  "version": 2,
  "$comment": "SINGLE SOURCE OF TRUTH for agent-hooks. Edit this file, then run `mise run hooks:sync` (or python3 sync.py --apply) to propagate to every agent's native hook config + publisher event map. Never hand-edit the generated artifacts (*/hooks.json, claude/settings.hooks.json, */event_map.generated.json) or a publisher's HOOK_MAP/EVENT_MAP \u2014 sync.py overwrites them from here. Ambiguous/divergent mappings are recorded in hooks.mappings.lock.json so the next sync is seamless. See README.md \u00a7'SSOT propagation'.",
  "meta": {
    "service_dir_placeholder": "{service_dir}",
    "contract": "../../docs/event-naming.md",
    "validator": "core/validate.py",
    "lock": "hooks.mappings.lock.json",
    "native_timeout_unit": "seconds except Gemini milliseconds"
  },
  "lifecycle": {
    "agent.session.started": {
      "type": "bloodbank.agent.session.started",
      "kind": "event",
      "ordering_bucket": "session",
      "role": "session_start",
      "description": "An agent CLI session began. Canonical (resolved 2026-06-07): agent.session.* supersedes cli.session.* for agent CLIs."
    },
    "agent.session.ended": {
      "type": "bloodbank.agent.session.ended",
      "kind": "event",
      "ordering_bucket": "session",
      "role": "session_end",
      "description": "An agent CLI session ended."
    },
    "conversation.turn.started": {
      "type": "bloodbank.conversation.turn.started",
      "kind": "event",
      "ordering_bucket": "thread",
      "role": "prompt_submit",
      "description": "A user prompt started a conversation turn."
    },
    "conversation.turn.completed": {
      "type": "bloodbank.conversation.turn.completed",
      "kind": "event",
      "ordering_bucket": "thread",
      "role": "turn_completed",
      "description": "A conversation turn reached a terminal state."
    },
    "agent.tool.requested": {
      "type": "bloodbank.agent.tool.requested",
      "kind": "event",
      "ordering_bucket": "invocation",
      "role": "pre_tool",
      "description": "A tool call was requested (pre-execution)."
    },
    "agent.tool.invoked": {
      "type": "bloodbank.agent.tool.invoked",
      "kind": "event",
      "ordering_bucket": "invocation",
      "role": "tool_invoked",
      "emitted": false,
      "description": "A tool was invoked. Defined for \u00a714 fidelity but NOT bound to a post-tool hook: resolved 2026-06-07 to use agent.tool.completed for the single post-tool hook surface."
    },
    "agent.tool.completed": {
      "type": "bloodbank.agent.tool.completed",
      "kind": "event",
      "ordering_bucket": "invocation",
      "role": "post_tool",
      "description": "A tool call reached a terminal state (post-execution, carries outcome). Canonical post-tool event for ALL agents (resolved 2026-06-07)."
    },
    "agent.invocation.started": {
      "type": "bloodbank.agent.invocation.started",
      "kind": "event",
      "ordering_bucket": "invocation",
      "role": "invocation_start",
      "description": "A (sub)agent invocation started."
    },
    "agent.invocation.completed": {
      "type": "bloodbank.agent.invocation.completed",
      "kind": "event",
      "ordering_bucket": "invocation",
      "role": "subagent_stop",
      "description": "A (sub)agent invocation completed. Canonical subagent-stop event for ALL agents (resolved 2026-06-07); supersedes the illegal agent.delegation.completed."
    },
    "agent.invocation.failed": {
      "type": "bloodbank.agent.invocation.failed",
      "kind": "event",
      "ordering_bucket": "invocation",
      "role": "invocation_failed",
      "description": "An agent invocation failed/errored."
    }
  },
  "agents": {
    "claude": {
      "label": "Claude Code",
      "dialect": "claude_settings",
      "config_target": "claude/settings.hooks.json",
      "live_target": "~/.claude/settings.json",
      "publisher": "bb-hook",
      "legacy_publishers": [
        "claude/publish.py",
        "bloodbank/publish.py"
      ],
      "event_map_target": "claude/event_map.generated.json",
      "runner": "{hooks_dir}/bb-hook --cli claude --native",
      "default_timeout": 4,
      "actor": {
        "type": "agent_cli",
        "agent_id": "bloodbank.agent.claude",
        "cli": "claude",
        "provider": "anthropic",
        "model": null
      },
      "bindings": [
        {
          "native": "SessionStart",
          "role": "session_start",
          "arg": "session-start",
          "lifecycle": "agent.session.started",
          "payload": "stdin",
          "timeout": 16
        },
        {
          "native": "UserPromptSubmit",
          "role": "prompt_submit",
          "arg": "prompt-submitted",
          "lifecycle": "conversation.turn.started",
          "payload": "stdin",
          "timeout": 16
        },
        {
          "native": "PreToolUse",
          "role": "pre_tool",
          "arg": "tool-request",
          "lifecycle": "agent.tool.requested",
          "payload": "stdin",
          "matcher": ".*"
        },
        {
          "native": "PostToolUse",
          "role": "post_tool",
          "arg": "tool-action",
          "lifecycle": "agent.tool.completed",
          "payload": "stdin",
          "matcher": ".*"
        },
        {
          "native": "SubagentStop",
          "role": "subagent_stop",
          "arg": "subagent-stopped",
          "lifecycle": "agent.invocation.completed",
          "payload": "stdin"
        },
        {
          "native": "Stop",
          "role": "turn_completed",
          "arg": "Stop",
          "lifecycle": "conversation.turn.completed",
          "payload": "stdin"
        },
        {
          "native": "Notification",
          "role": "attention",
          "arg": "Notification",
          "publish": false,
          "alert": "attention",
          "attention_kind": "bell",
          "payload": "stdin",
          "timeout": 4
        },
        {
          "native": "PermissionRequest",
          "role": "attention",
          "arg": "PermissionRequest",
          "publish": false,
          "alert": "attention",
          "attention_kind": "gate",
          "payload": "stdin",
          "timeout": 4
        },
        {
          "native": "TeammateIdle",
          "role": "attention",
          "arg": "TeammateIdle",
          "publish": false,
          "alert": "attention",
          "attention_kind": "bell",
          "payload": "stdin",
          "timeout": 4
        },
        {
          "native": "SessionEnd",
          "role": "session_end",
          "arg": "SessionEnd",
          "lifecycle": "agent.session.ended",
          "payload": "stdin"
        },
        {
          "native": "PostToolUseFailure",
          "role": "post_tool",
          "arg": "PostToolUseFailure",
          "lifecycle": "agent.tool.completed",
          "payload": "stdin",
          "matcher": ".*"
        },
        {
          "native": "SubagentStart",
          "role": "invocation_start",
          "arg": "SubagentStart",
          "lifecycle": "agent.invocation.started",
          "payload": "stdin"
        },
        {
          "native": "StopFailure",
          "role": "invocation_failed",
          "arg": "stop-failure",
          "lifecycle": "agent.invocation.failed",
          "payload": "stdin"
        }
      ],
      "support_status": "supported",
      "default_timeout_sec": 4
    },
    "copilot": {
      "label": "GitHub Copilot CLI",
      "dialect": "copilot",
      "config_target": "copilot/hooks.json",
      "live_target": "~/.copilot/hooks/bloodbank.json",
      "publisher": "bb-hook",
      "legacy_publishers": [
        "copilot/publish.py",
