      ],
      "event_map_target": "copilot/event_map.generated.json",
      "runner": "{hooks_dir}/bb-hook --cli copilot --native",
      "default_timeout_sec": 4,
      "actor": {
        "type": "agent_cli",
        "agent_id": "bloodbank.agent.copilot",
        "cli": "copilot",
        "provider": "github_copilot",
        "model": null
      },
      "bindings": [
        {
          "native": "sessionStart",
          "role": "session_start",
          "arg": "sessionStart",
          "lifecycle": "agent.session.started",
          "payload": "stdin",
          "timeout": 16,
          "timeoutSec": 16
        },
        {
          "native": "sessionEnd",
          "role": "session_end",
          "arg": "sessionEnd",
          "lifecycle": "agent.session.ended",
          "payload": "stdin"
        },
        {
          "native": "userPromptSubmitted",
          "role": "prompt_submit",
          "arg": "userPromptSubmitted",
          "lifecycle": "conversation.turn.started",
          "payload": "stdin",
          "timeout": 16,
          "timeoutSec": 16
        },
        {
          "native": "preToolUse",
          "role": "pre_tool",
          "arg": "preToolUse",
          "lifecycle": "agent.tool.requested",
          "payload": "stdin"
        },
        {
          "native": "postToolUse",
          "role": "post_tool",
          "arg": "postToolUse",
          "lifecycle": "agent.tool.completed",
          "payload": "stdin"
        },
        {
          "native": "errorOccurred",
          "role": "invocation_failed",
          "arg": "errorOccurred",
          "lifecycle": "agent.invocation.failed",
          "payload": "stdin"
        },
        {
          "native": "agentStop",
          "role": "subagent_stop",
          "arg": "agentStop",
          "lifecycle": "agent.invocation.completed",
          "payload": "stdin"
        },
        {
          "native": "permissionRequest",
          "role": "attention",
          "arg": "permissionRequest",
          "publish": false,
          "alert": "attention",
          "attention_kind": "gate",
          "payload": "stdin",
          "timeoutSec": 4
        }
      ],
      "support_status": "supported",
      "default_timeout": 4
    },
    "codex": {
      "label": "Codex CLI",
      "dialect": "codex",
      "config_target": "codex/hooks.json",
      "live_target": "~/.codex/hooks.json",
