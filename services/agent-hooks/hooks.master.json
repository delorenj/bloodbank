          "arg": "on_session_start",
          "lifecycle": "agent.session.started",
          "payload": "stdin",
          "timeout": 16
        },
        {
          "native": "on_session_end",
          "role": "turn_completed",
          "arg": "on_session_end",
          "lifecycle": "conversation.turn.completed",
          "payload": "stdin"
        },
        {
          "native": "pre_llm_call",
          "role": "prompt_submit",
          "arg": "pre_llm_call",
          "lifecycle": "conversation.turn.started",
          "payload": "stdin",
          "timeout": 16
        },
        {
          "native": "pre_tool_call",
          "role": "pre_tool",
          "arg": "pre_tool_call",
          "lifecycle": "agent.tool.requested",
          "fail_closed": false,
          "payload": "stdin"
        },
        {
          "native": "post_tool_call",
          "role": "post_tool",
          "arg": "post_tool_call",
          "lifecycle": "agent.tool.completed",
          "payload": "stdin"
        },
        {
          "native": "subagent_stop",
          "role": "subagent_stop",
          "arg": "subagent_stop",
          "lifecycle": "agent.invocation.completed",
          "payload": "stdin"
        },
        {
          "native": "post_llm_call",
          "role": "after_response",
          "arg": "post_llm_call",
          "publish": false,
          "payload": "stdin"
        },
        {
          "native": "pre_approval_request",
          "role": "attention",
          "arg": "pre_approval_request",
          "publish": false,
          "alert": "attention",
          "attention_kind": "gate",
          "payload": "stdin"
        },
        {
          "native": "post_approval_response",
          "role": "permission_resolved",
          "arg": "post_approval_response",
          "publish": false,
          "payload": "stdin"
        },
        {
          "native": "on_session_finalize",
          "role": "session_end",
          "arg": "on_session_finalize",
          "lifecycle": "agent.session.ended",
          "payload": "stdin"
        },
        {
          "native": "on_session_reset",
          "role": "session_reset",
          "arg": "on_session_reset",
          "publish": false,
          "payload": "stdin"
        },
        {
          "native": "subagent_start",
          "role": "invocation_start",
          "arg": "subagent_start",
          "lifecycle": "agent.invocation.started",
          "payload": "stdin"
        }
      ],
      "support_status": "supported",
      "default_timeout_sec": 4,
      "live_target": "~/.hermes/config.yaml",
      "profiles_dir": "~/.hermes/profiles"
    },
    "antigravity": {
      "label": "Antigravity CLI",
      "dialect": "antigravity_bundle",
      "config_target": "antigravity/hooks.json",
      "live_target": "~/.gemini/config/hooks.json",
      "bundle_name": "bloodbank",
      "publisher": "bb-hook",
      "legacy_publishers": [
        "antigravity/publish.py",
        "bloodbank/publish.py"
      ],
      "event_map_target": "antigravity/event_map.generated.json",
      "runner": "{hooks_dir}/bb-hook --cli antigravity --native",
      "default_timeout": 4,
      "note": "Antigravity CLI (Gemini fork) reads NAMED hook bundles from ~/.gemini/config/hooks.json: each top-level key is a bundle mapping native event -> handlers. Flat events (PreInvocation/PostInvocation/Stop) take handler objects directly; tool events (PreToolUse/PostToolUse) take {matcher, hooks[]} groups. Every hook must print a JSON response: {} for passive events, {\"decision\":\"\"} for Stop \u2014 the renderer appends the right printf. Install replaces ONLY the 'bloodbank' bundle, preserving foreign bundles (orca-status, skill-check-reminder, ...). PreToolUse is deliberately UNBOUND: its hooks gate tool permissions (decision required) and an observational hook can block or auto-allow user tools \u2014 the same reason Orca skips it. No antigravity payload carries the user prompt, so prompt_submit has no native surface; PostToolUse carries no toolCall (only stepIdx/error), so tool_name is 'unknown'.",
      "actor": {
        "type": "agent_cli",
        "agent_id": "bloodbank.agent.antigravity",
        "cli": "antigravity",
        "provider": "google",
        "model": null
      },
      "bindings": [
        {
          "native": "PreInvocation",
          "role": "invocation_start",
          "arg": "PreInvocation",
          "lifecycle": "agent.invocation.started",
          "payload": "stdin"
        },
        {
          "native": "PostInvocation",
          "role": "subagent_stop",
          "arg": "PostInvocation",
          "lifecycle": "agent.invocation.completed",
          "payload": "stdin"
        },
        {
          "native": "PostToolUse",
          "role": "post_tool",
          "arg": "PostToolUse",
          "lifecycle": "agent.tool.completed",
          "payload": "stdin",
          "matcher": "*"
        },
        {
          "native": "Stop",
          "role": "session_end",
          "arg": "Stop",
          "lifecycle": "agent.session.ended",
          "payload": "stdin"
        }
      ],
      "support_status": "supported",
      "default_timeout_sec": 4
    },
