# 1Password reference, safe to commit. render-env.sh resolves it into the
# gitignored .env, which `docker compose` loads on its own for ${...}
# interpolation, so a bare `docker compose up` needs no token in the shell.
# Item "ntfy Access Token", referenced by UUID: duplicate titles in the vault break title references.
BLOODBANK_NTFY_ROUTER_NTFY_TOKEN=op://DeLoSecrets/4emrs3darycjailotjdsydusyu/credential

# BB-34 ntfy cutover: tolt-family seam enabled by owner acceptance (plain
# booleans, not secrets — render-env.sh passes them through with the token).
BLOODBANK_NTFY_ROUTER_TOLT_ENABLED=true
BLOODBANK_NTFY_ROUTER_TOLT_CUTOVER_ACCEPTED=true
