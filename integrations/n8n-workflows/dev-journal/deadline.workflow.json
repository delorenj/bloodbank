    {
      "id": "57919949-7b3d-4ce4-abea-06d217593da4",
      "name": "Store deadline receipt",
      "type": "n8n-nodes-bloodbank.devJournal",
      "typeVersion": 1,
      "position": [
        720,
        0
      ],
      "parameters": {
        "operation": "recordEmail",
        "mail": "={{ $('Prepare honest partial if pending').first().json }}"
      }
    }
