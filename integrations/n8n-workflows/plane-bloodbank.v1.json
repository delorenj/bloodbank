      {
        "parameters": {
          "jsCode": "// At most one 'Unrouted Board' page per board per 24h. An unrouted board\n// sends every ticket event it has, and before this gate each one paged.\n// The first delivery from a board in a 24h window is marked notify=true and\n// pages; the rest are notify=false and end on 'Unrouted — Muted', so the\n// webhook (Respond: Last Node) still has an item to answer 200 with.\n// Workflow static data is enough here: this workflow is the only writer and\n// the volume is a handful of boards a day. n8n saves it after each production\n// execution; manual test runs do not persist it.\nconst DAY_MS = 24 * 60 * 60 * 1000;\nconst store = $getWorkflowStaticData('global');\nconst paged = store.unroutedBoardPagedAt && typeof store.unroutedBoardPagedAt === 'object'\n  ? store.unroutedBoardPagedAt\n  : {};\nconst now = Date.now();\nfor (const [board, at] of Object.entries(paged)) {\n  if (!(now - Number(at) < DAY_MS)) delete paged[board];\n}\nconst out = $input.all().map((item, index) => {\n  const board = String(item.json.board_id || item.json.project_id || 'unknown');\n  const last = Number(paged[board]);\n  const notify = !(now - last < DAY_MS);\n  if (notify) paged[board] = now;\n  return {\n    json: {\n      ...item.json,\n      notify,\n      muted_until: notify ? null : new Date(last + DAY_MS).toISOString(),\n    },\n    pairedItem: { item: index },\n  };\n});\nstore.unroutedBoardPagedAt = paged;\nreturn out;\n"
        },
