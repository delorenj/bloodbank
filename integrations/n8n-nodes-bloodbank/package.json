{
  "name": "n8n-nodes-bloodbank",
  "version": "0.4.0",
  "description": "Schema-backed n8n publisher, consumer trigger, Plane webhook ingress and agent-fleet dispatch for the 33GOD Bloodbank NATS bus",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "bloodbank",
    "nats",
    "cloudevents",
    "33god"
  ],
  "license": "MIT",
  "homepage": "https://github.com/delorenj/bloodbank/tree/main/integrations/n8n-nodes-bloodbank#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/delorenj/bloodbank.git",
    "directory": "integrations/n8n-nodes-bloodbank"
  },
  "bugs": "https://github.com/delorenj/bloodbank/issues",
  "author": "Jarad DeLorenzo <jaradd@gmail.com>",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "n8n": {
    "n8nNodesApiVersion": 1,
    "nodes": [
      "dist/nodes/Bloodbank/Bloodbank.node.js",
      "dist/nodes/BloodbankTrigger/BloodbankTrigger.node.js",
      "dist/nodes/Fleet/Fleet.node.js",
      "dist/nodes/PlaneBloodbank/PlaneBloodbank.node.js"
    ]
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "codegen": "node codegen/generate-events.mjs",
    "icons": "node scripts/copy-icons.mjs",
    "build": "npm run codegen && tsc && npm run icons",
    "test": "npm run build && tsx --test test/*.test.cjs",
    "test:live": "npm run build && tsx --test test/live-nats.integration.cjs",
    "test:live-plane": "node --test test/live-plane-webhook.integration.cjs",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@nats-io/transport-node": "3.4.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "n8n-workflow": "^2.9.0",
    "tsx": "4.23.12",
    "typescript": "^5.9.3"
  }
}
