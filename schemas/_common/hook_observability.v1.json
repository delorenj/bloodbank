        "interrupted": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "cli",
        "native",
        "invocations"
      ],
      "additionalProperties": false
    },
    "handler_activity": {
      "type": "object",
      "properties": {
        "handler_id": {
          "type": "string",
          "maxLength": 4096
        },
        "cli": {
          "type": "string",
          "maxLength": 4096
        },
        "status": {
          "type": "string",
          "maxLength": 4096
        },
        "count": {
          "type": "integer",
          "minimum": 0
