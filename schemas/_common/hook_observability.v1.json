    "source": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "maxLength": 4096
        },
        "hub_count": {
          "type": "integer",
          "minimum": 0
        },
        "direct_count": {
          "type": "integer",
          "minimum": 0
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        }
      },
      "required": [
        "source",
        "hub_count",
        "direct_count",
