      "type": "object",
      "properties": {
        "invocation_id": {
          "type": "string",
          "maxLength": 4096
        },
        "handler_id": {
          "type": "string",
          "maxLength": 4096
        },
        "mode": {
          "type": "string",
          "maxLength": 4096
        },
        "status": {
          "type": "string",
          "maxLength": 4096
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "selected_at": {
          "type": "string",
          "format": "date-time"
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "finished_at": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "duration_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "event_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "event_type": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "publish_status": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        }
      },
      "required": [
        "handler_id",
        "mode",
        "status",
        "selected_at"
      ],
      "additionalProperties": false
    },
    "transition": {
      "type": "object",
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "handler_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "status": {
          "type": "string",
          "maxLength": 4096
        },
        "reason": {
          "type": [
            "string",
            "null"
