        "at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "sequence",
        "status",
        "at"
      ],
      "additionalProperties": false
    },
    "invocation": {
      "type": "object",
      "properties": {
        "invocation_id": {
          "type": "string",
          "maxLength": 4096
        },
        "cli": {
          "type": "string",
          "maxLength": 4096
        },
        "native": {
          "type": "string",
          "maxLength": 4096
        },
        "role": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "event_type": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "identity_kind": {
          "type": "string",
          "maxLength": 4096
