{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/_common/hook_observability.v1.json",
  "title": "Payload-free hook observability projections",
  "description": "Allowlisted receipt and installed inventory metadata. No native input, prompts, commands, transcripts, stdout, stderr or environment values. Long receipt timelines retain their latest 512 transitions with explicit total/truncation metadata.",
