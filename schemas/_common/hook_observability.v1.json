              }
            },
            "status": {
              "type": "string",
              "maxLength": 4096
            }
          },
          "required": [
            "native",
            "status"
          ],
          "additionalProperties": false
        },
        "handler_ids": {
          "type": "array",
          "items": {
            "type": "string",
