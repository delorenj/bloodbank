        "executions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/execution"
          }
        },
        "timeline": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transition"
          }
        },
        "timeline_total": {
          "type": "integer",
          "minimum": 0
        },
        "timeline_truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "invocation_id",
        "cli",
        "native",
        "received_at",
        "updated_at",
        "status",
        "executions",
        "timeline"
      ],
      "additionalProperties": false
