{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/system/hook.updated.json",
  "title": "Hook snapshot updated",
  "description": "Immutable hook-hub configuration or compact health observation committed to the durable outbox. Full snapshot on startup, inventory change and hourly; heartbeat every30seconds omits repeated inventory. Consumers merge heartbeat into the latest full snapshot from the same hub_id. Revisions are durable sequence numbers; expires_at uses observation time, never delivery time.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.system.hook.updated"
    },
    "kind": {
      "const": "event"
    },
    "domain": {
      "const": "system"
    },
    "data": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "hub_id": {
          "type": "string",
          "format": "uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "snapshot": {
          "$ref": "../../_common/hook_observability.v1.json#/$defs/snapshot"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "heartbeat": {
          "$ref": "../../_common/hook_observability.v1.json#/$defs/heartbeat"
        }
      },
      "required": [
        "schema_version",
        "hub_id",
        "sequence",
        "revision",
        "expires_at"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "snapshot"
          ]
        },
        {
          "required": [
            "heartbeat"
          ]
        }
      ]
    }
  },
  "required": [
    "type",
    "kind",
    "domain",
    "data"
  ]
}
