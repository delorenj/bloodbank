{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/workflow/task.completed.json",
  "title": "Workflow Task Completed Event",
  "description": "A workflow run finished its task. See bloodbank/docs/event-naming.md.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.workflow.task.completed"
    },
    "kind": {
      "const": "event"
    },
    "domain": {
      "const": "workflow"
    },
    "data": {
      "type": "object",
      "description": "Payload for bloodbank.workflow.task.completed.",
      "properties": {
        "workflow": {
          "type": "string",
          "minLength": 1,
          "description": "Workflow that produced the event (e.g. free-scout)."
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "description": "The workflow run's identifier."
        },
        "provider": {
          "type": "string",
          "description": "Provider the run worked on, when there was one."
        },
        "outcome": {
          "type": "string",
          "description": "What the run achieved, e.g. integrated or no_candidates."
        },
        "summary": {
          "type": "string",
          "description": "One-line human summary."
        }
      },
      "required": [
        "workflow",
        "run_id",
        "outcome"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "type",
    "kind",
    "domain",
    "data"
  ]
}
