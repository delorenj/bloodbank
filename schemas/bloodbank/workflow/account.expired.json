{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/workflow/account.expired.json",
  "title": "Workflow Account Expired Event",
  "description": "An account a workflow created was never confirmed: its confirmation message did not arrive within the workflow's checks, so the sign-up was abandoned. See bloodbank/docs/event-naming.md.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.workflow.account.expired"
    },
    "kind": {
      "const": "event"
    },
    "domain": {
      "const": "workflow"
    },
    "data": {
      "type": "object",
      "description": "Payload for bloodbank.workflow.account.expired.",
      "properties": {
        "workflow": {
          "type": "string",
          "minLength": 1,
          "description": "Workflow that produced the event (e.g. free-scout)."
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "description": "The workflow run's identifier."
        },
        "provider": {
          "type": "string",
          "description": "Provider the run worked on, when there was one."
        },
        "channel": {
          "type": "string",
          "enum": [
            "email",
            "sms"
          ],
          "description": "Where the confirmation was expected."
        },
        "attempts": {
          "type": "integer",
          "minimum": 0,
          "description": "Confirmation checks made before giving up."
        },
        "reason": {
          "type": "string",
          "description": "Why the account expired, e.g. confirmation_not_received."
        }
      },
      "required": [
        "workflow",
        "run_id",
        "provider",
        "channel",
        "attempts"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "type",
    "kind",
    "domain",
    "data"
  ]
}
