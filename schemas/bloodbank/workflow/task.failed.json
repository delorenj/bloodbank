{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/workflow/task.failed.json",
  "title": "Workflow Task Failed Event",
  "description": "A workflow run stopped without finishing its task. Producers: the gateway's free-provider scout (bb-emit) and the n8n ticket lifecycle lanes (Lifecycle Lane Errors, via the n8n-nodes-bloodbank Fleet node's Report Lane Failure operation). The four required data fields are the whole legacy contract; every other field is an optional, additive typed extension for lane failures. See bloodbank/docs/event-naming.md.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.workflow.task.failed"
    },
    "kind": {
      "const": "event"
    },
    "domain": {
      "const": "workflow"
    },
    "data": {
      "type": "object",
      "description": "Payload for bloodbank.workflow.task.failed.",
      "properties": {
        "workflow": {
          "type": "string",
          "minLength": 1,
          "description": "Workflow that produced the event (e.g. free-scout)."
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "description": "The workflow run's identifier."
        },
        "provider": {
          "type": "string",
          "description": "Provider the run worked on, when there was one."
        },
        "stage": {
          "type": "string",
          "description": "Stage that failed."
        },
        "reason": {
          "type": "string",
          "description": "Why it failed. Lane producers cap it at 500 characters and redact secrets."
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "One line a notifier can show as-is (ntfy-router shows this)."
        },
        "lane": {
          "type": "object",
          "description": "The automation lane run that failed. Present on lane failures; absent on legacy producers such as the free-provider scout.",
          "properties": {
            "engine": {
              "const": "n8n"
            },
            "workflow_id": {
              "type": "string",
              "minLength": 1
            },
            "workflow_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "execution_id": {
              "type": "string",
              "minLength": 1,
              "description": "n8n execution id. A failure inside the trigger itself has no execution; its id is trigger-<12 hex>, stable for an hour."
            },
            "execution_url": {
              "type": [
                "string",
                "null"
              ]
            },
            "mode": {
              "type": [
                "string",
                "null"
              ],
              "description": "n8n execution mode, e.g. trigger, retry, manual."
            },
            "retry_of": {
              "type": [
                "string",
                "null"
              ],
              "description": "Execution this one retried, when it was a retry."
            },
            "trigger_type": {
              "type": [
                "string",
                "null"
              ],
              "description": "Bloodbank type of the event that started the run, e.g. bloodbank.repo.task.created."
            },
            "trigger_event_id": {
              "type": [
                "string",
                "null"
              ],
              "description": "Envelope id of the event that started the run."
            }
          },
          "required": [
            "workflow_id",
            "execution_id"
          ],
          "additionalProperties": true
        },
        "target_agent_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Fleet agent that owns the ticket's board, when one was resolved."
        },
        "matched_by": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "board",
            "fallback",
            "none",
            null
          ],
          "description": "How the owner was resolved: by board id, by the <repo>-pm convention, or not at all."
        },
        "context": {
          "type": "object",
          "description": "The ticket context of the failed run, on the same paths as bloodbank.agent.invocation.skipped's context, so a failure, a skip and a dispatch are filterable together.",
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 1,
              "description": "Lane purpose, e.g. ticket-grooming, ticket-delegation, or the lane slug."
            },
            "repo": {
              "type": [
                "string",
                "null"
              ]
            },
            "ticket_key": {
              "type": [
                "string",
                "null"
              ]
            },
            "ticket_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "board_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "workspace": {
              "type": [
                "string",
                "null"
              ]
            },
            "title": {
              "type": [
                "string",
                "null"
              ]
            },
            "phase": {
              "type": [
                "string",
                "null"
              ]
            },
            "previous_phase": {
              "type": [
                "string",
                "null"
              ]
            },
            "provider_event_type": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "reason"
          ],
          "additionalProperties": true
        },
        "company_identity": {
          "type": [
            "object",
            "null"
          ],
          "description": "The owning agent's company identity as the fleet registry projects it from the employee's role.yaml. null means the owner is not enrolled (or none was resolved). Never carries a credential reference.",
          "properties": {
            "subject": {
              "type": "string",
              "format": "uuid",
              "description": "Immutable company subject, the join key."
            },
            "handle": {
              "type": "string",
              "minLength": 1
            },
            "email": {
              "type": "string",
              "pattern": "^[^@\\s]+@agents\\.delo\\.sh$"
            },
            "status": {
              "type": "string",
              "enum": [
                "active",
                "suspended",
                "retired"
              ]
            },
            "plane_attribution": {
              "type": "string",
              "enum": [
                "native",
                "unbound"
              ],
              "description": "native: the employee has a verified native Plane actor; unbound: it acts through a shared key."
            }
          },
          "required": [
            "subject",
            "handle",
            "email",
            "status",
            "plane_attribution"
          ],
          "additionalProperties": true
        },
        "gateway_consumer": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "AutomaticAI gateway consumer the owner's desk uses ('hermes' is the fleet's shared base consumer); null when unknown."
        },
        "error": {
          "type": "object",
          "description": "Machine-readable classification of what broke. Never carries a stack trace or a credential.",
          "properties": {
            "class": {
              "type": "string",
              "enum": [
                "rate_limited",
                "auth_failed",
                "not_found",
                "no_route",
                "ineligible",
                "invalid_payload",
                "upstream_unavailable",
                "timeout",
                "bus_unavailable",
                "node_error",
                "unknown"
              ]
            },
            "http_status": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 100,
              "maximum": 599
            },
            "upstream": {
              "type": [
                "string",
                "null"
              ],
              "description": "System the failing call went to, e.g. plane, nats."
            },
            "credential_scope": {
              "type": "string",
              "enum": [
                "fleet_shared",
                "employee",
                "service",
                "none",
                "unknown"
              ],
              "description": "Whose credential the failing call used: the shared fleet credential, the employee's own, a service account, or none."
            },
            "retry_after_seconds": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          },
          "required": [
            "class"
          ],
          "additionalProperties": true
        },
        "severity": {
          "type": "string",
          "enum": [
            "page",
            "low"
          ],
          "description": "page: a person should look; low: self-healing, record only."
        },
        "recovery": {
          "type": "object",
          "description": "What re-drives the work.",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "retry_execution",
                "requeue_ticket",
                "retry_or_requeue",
                "fix_route",
                "rotate_credential",
                "enroll_identity",
                "none"
              ]
            },
            "hint": {
              "type": "string",
              "maxLength": 400,
              "description": "The exact command or call, in a sentence."
            }
          },
          "required": [
            "action",
            "hint"
          ],
          "additionalProperties": true
        },
        "links": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "description": "Page and run links a notifier can turn into buttons: the ticket page and the failed execution.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "rel": {
                "type": "string",
                "enum": [
                  "page",
                  "run"
                ],
                "description": "page: the ticket; run: the failed execution."
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "url": {
                "type": "string",
                "maxLength": 600,
                "pattern": "^https://[^\\s\"<>]+$"
              }
            },
            "required": [
              "rel",
              "label",
              "url"
            ]
          }
        },
        "redacted": {
          "const": true,
          "description": "The producer stripped anything secret-shaped from reason and every other string before publishing."
        }
      },
      "required": [
        "workflow",
        "run_id",
        "stage",
        "reason"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "type",
    "kind",
    "domain",
    "data"
  ]
}
