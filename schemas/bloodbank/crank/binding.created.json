{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/crank/binding.created.json",
  "title": "Crank Binding Created Event",
  "description": "A crank was bound to one live interactive agent session (crank v2, pjangler PJAN-214): its own Candybar now fires the crank officer for that session every interval. Emitted by `pj crank attach` (the hook-hub crank-attach row on SessionStart, or `pj crank enable`). See bloodbank/docs/event-naming.md (crank).",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.crank.binding.created"
    },
    "kind": {
      "const": "event"
    },
    "domain": {
      "const": "crank"
    },
    "ordering_key": {
      "type": "string",
      "pattern": "^binding:crank-[a-z0-9-]+$",
      "description": "§11.1 bucket binding:<name>: every fact of one crank, in order."
    },
    "data": {
      "type": "object",
      "description": "Payload for bloodbank.crank.binding.created.",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "binding": {
          "type": "string",
          "pattern": "^crank-[a-z0-9]+-[a-z0-9]+-[0-9]+$",
          "description": "The crank's name, crank-<cli>-<sid8>-<pid>; also its Candybar name."
        },
        "cli": {
          "type": "string",
          "minLength": 1,
          "description": "Agent CLI: claude, codex, kimi, opencode, ..."
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "description": "The agent's native session id."
        },
        "pid": {
          "type": "integer",
          "minimum": 1,
          "description": "The agent process the crank is bound to (with its start time)."
        },
        "pane_id": {
          "type": "string",
          "pattern": "^terminal_[0-9]+$",
          "description": "Where the session lived when bound: location only, never identity."
        },
        "zellij_session": {
          "type": "string",
          "minLength": 1
        },
        "project": {
          "type": "string",
          "minLength": 1,
          "description": "Project slug from .project.json."
        },
        "interval": {
          "type": "string",
          "pattern": "^[0-9]+[mhd]$"
        },
        "schedule": {
          "type": "string",
          "minLength": 9,
          "description": "The 5-field cron of the crank's Candybar."
        },
        "candybar_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "schema_version",
        "binding",
        "cli",
        "session_id",
        "pid",
        "pane_id",
        "project",
        "interval",
        "schedule",
        "candybar_id"
      ]
    }
  },
  "required": [
    "type",
    "kind",
    "domain",
    "ordering_key",
    "data"
  ]
}
