{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/crank/duty.started.json",
  "title": "Crank Duty Started Event",
  "description": "Wingman went on duty: it learned every tab in the operator's crank circuit and now watches them, speaking up when one needs the operator. One duty session lasts until crank.duty.ended with the same data.duty_id. See bloodbank/docs/event-naming.md (crank).",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.crank.duty.started"
    },
    "kind": {
      "const": "event"
    },
    "domain": {
      "const": "crank"
    },
    "ordering_key": {
      "type": "string",
      "pattern": "^duty:[0-9a-f-]{36}$",
      "description": "§11.1 bucket duty:<duty_id>: every fact of one duty session, in order."
    },
    "data": {
      "type": "object",
      "description": "Payload for bloodbank.crank.duty.started.",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "duty_id": {
          "type": "string",
          "format": "uuid",
          "description": "One duty session, from going on duty to going off. Also the envelope correlationid."
        },
        "session": {
          "type": "string",
          "minLength": 1,
          "description": "The zellij session watched, e.g. Workspace."
        },
        "tabs": {
          "type": "array",
          "maxItems": 64,
          "description": "Every crank tab at the start, as first read.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "project_id": {
                "type": "string",
                "minLength": 1
              },
              "tab_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "state": {
                "type": "string",
                "enum": [
                  "working",
                  "needs_decision",
                  "done",
                  "delegated",
                  "error",
                  "idle",
                  "missing",
                  "unknown"
                ],
                "description": "The tab's state as Wingman classifies it."
              }
            },
            "required": [
              "project_id",
              "state"
            ]
          }
        },
        "waiting": {
          "type": "integer",
          "minimum": 0,
          "description": "How many tabs were already waiting on the operator (needs_decision, done or error)."
        },
        "poll_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "The duty poll interval."
        },
        "events": {
          "type": "boolean",
          "description": "Whether duty also wakes on ASM transitions and Deckard attention events."
        },
        "voice": {
          "type": "string",
          "description": "The vox voice it speaks in."
        },
        "muted": {
          "type": "boolean",
          "description": "Lines are printed to the duty log instead of spoken."
        }
      },
      "required": [
        "schema_version",
        "duty_id",
        "session",
        "tabs",
        "waiting"
      ]
    }
  },
  "required": [
    "type",
    "kind",
    "domain",
    "ordering_key",
    "data"
  ]
}
