{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/crank/alert.raised.json",
  "title": "Crank Alert Raised Event",
  "description": "Wingman told the operator something about the operator's crank tabs: a tab started waiting on the operator, finished, broke, has waited too long, or the tab the operator is looking at changed. One fact per line Wingman decided to say; a tick the model answered with silence raises nothing. data.text is the line itself. See bloodbank/docs/event-naming.md (crank).",
  "$comment": "No screen contents in data: a pane's screen can hold anything, secrets included. The text is Wingman's own line.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.crank.alert.raised"
    },
    "kind": {
      "const": "event"
    },
    "domain": {
      "const": "crank"
    },
    "ordering_key": {
      "type": "string",
      "pattern": "^duty:[0-9a-f-]{36}$",
      "description": "§11.1 bucket duty:<duty_id>: every fact of one duty session, in order."
    },
    "data": {
      "type": "object",
      "description": "Payload for bloodbank.crank.alert.raised.",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "duty_id": {
          "type": "string",
          "format": "uuid",
          "description": "One duty session, from going on duty to going off. Also the envelope correlationid."
        },
        "session": {
          "type": "string",
          "minLength": 1,
          "description": "The zellij session watched, e.g. Workspace."
        },
        "project_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "The tabs the line is about, by pjangler project id, most urgent first."
        },
        "signals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "description": "The deterministic signals that made Wingman speak.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "transition",
                  "reminder",
                  "focus",
                  "staring",
                  "recovered",
                  "commentary"
                ]
              },
              "project_id": {
                "type": "string",
                "minLength": 1
              },
              "state": {
                "type": "string",
                "enum": [
                  "working",
                  "needs_decision",
                  "done",
                  "delegated",
                  "error",
                  "idle",
                  "missing",
                  "unknown"
                ],
                "description": "The tab's state as Wingman classifies it."
              },
              "minutes_waiting": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "kind",
              "project_id",
              "state"
            ]
          }
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "What Wingman said."
        },
        "delivery": {
          "type": "string",
          "enum": [
            "spoken",
            "muted",
            "failed"
          ],
          "description": "spoken: vox rendered it and it played. muted: Wingman is muted, so it only went to the duty log. failed: TTS or playback failed."
        },
        "opening": {
          "type": "boolean",
          "description": "The line Wingman opened the duty session with."
        },
        "model": {
          "type": "string",
          "description": "The model route that phrased it."
        }
      },
      "required": [
        "schema_version",
        "duty_id",
        "session",
        "project_ids",
        "signals",
        "text",
        "delivery"
      ]
    }
  },
  "required": [
    "type",
    "kind",
    "domain",
    "ordering_key",
    "data"
  ]
}
