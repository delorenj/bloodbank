{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/v1/repo/board.created.v1.json",
  "title": "Repo Board Created Event",
  "description": "A project board was created for a repo. Provider identity and the lossless board entity live in data.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.v1.repo.board.created"
    },
    "kind": {
      "const": "event"
    },
    "domain": {
      "const": "repo"
    },
    "data": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "workspace": {
          "type": "string",
          "minLength": 1
        },
        "board_id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "board_key": {
          "type": ["string", "null"]
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "provider_event_type": {
          "type": "string",
          "minLength": 1,
          "description": "Provider provenance name, for example plane.board.created."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "board": {
          "type": "object",
          "description": "Lossless JSON board entity supplied by the provider.",
          "additionalProperties": true
        }
      },
      "required": [
        "repo",
        "slug",
        "workspace",
        "board_id",
        "project_id",
        "provider",
        "provider_event_type",
        "timestamp",
        "board"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "type",
    "kind",
    "domain",
    "data"
  ]
}
