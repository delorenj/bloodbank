{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/v1/repo/skill.updated.v1.json",
  "title": "Repo Skill Updated Event",
  "description": "A repo-scoped agent skill was updated by an automated tuning cycle (e.g. the merge-forward session-end rebalancer). The repo slug and skill name belong in data, not in the CloudEvents type.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.v1.repo.skill.updated"
    },
    "kind": {
      "const": "event"
    },
    "domain": {
      "const": "repo"
    },
    "data": {
      "type": "object",
      "description": "Payload for bloodbank.v1.repo.skill.updated.",
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "skill": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": "string"
        },
        "client": {
          "type": ["string", "null"]
        },
        "files_changed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "commit": {
          "type": "string"
        },
        "validation": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "repo",
        "skill"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "type",
    "kind",
    "domain",
    "data"
  ]
}
