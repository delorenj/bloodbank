{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/agent/hook.updated.json",
  "title": "Hook invocation updated",
  "description": "Immutable full invocation revision, including execution outcomes and recent timeline. Native signals without canonical agent events are still represented. Backfills retain original receipt timestamps and get new monotonic revisions.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.agent.hook.updated"
    },
    "kind": {
      "const": "event"
    },
    "domain": {
      "const": "agent"
    },
    "data": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "hub_id": {
          "type": "string",
          "format": "uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "invocation": {
          "$ref": "../../_common/hook_observability.v1.json#/$defs/invocation"
        },
        "backfill": {
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "hub_id",
        "sequence",
        "revision",
        "invocation"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "type",
    "kind",
    "domain",
    "data"
  ]
}
