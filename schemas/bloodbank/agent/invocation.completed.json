{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/agent/invocation.completed.json",
  "title": "Agent Invocation Completed Event",
  "description": "An agent invocation completed successfully. See bloodbank/docs/event-naming.md.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.agent.invocation.completed"
    },
    "kind": {
      "const": "event"
    },
    "domain": {
      "const": "agent"
    },
    "data": {
      "type": "object",
      "description": "Payload for bloodbank.agent.invocation.completed.",
      "properties": {
        "invocation_id": {
          "type": "string",
          "minLength": 1
        },
        "thread_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "turn_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "context": {
          "type": [
            "object",
            "null"
          ],
          "description": "Echo of the originating bloodbank.agent.invocation.start command's data.context, verbatim. Ticket turns carry reason (ticket-grooming|ticket-delegation), repo, ticket_key, ticket_id, board_id, workspace, title and phase so consumers can act statelessly. Omitted when the command carried no context.",
          "additionalProperties": true
        }
      },
      "required": [
        "invocation_id"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "type",
    "kind",
    "domain",
    "data"
  ]
}
