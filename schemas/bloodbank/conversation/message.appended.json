{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/conversation/message.appended.json",
  "title": "Conversation Message Appended Event",
  "description": "A message was appended to the durable conversation transcript. See bloodbank/docs/event-naming.md.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.conversation.message.appended"
    },
    "kind": {
      "const": "event"
    },
    "domain": {
      "const": "conversation"
    },
    "data": {
      "type": "object",
      "description": "Payload for bloodbank.conversation.message.appended.",
      "properties": {
        "thread_id": {
          "type": "string",
          "minLength": 1
        },
        "turn_id": {
          "type": "string",
          "minLength": 1
        },
        "message_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "enum": [
            "user",
            "assistant",
            "system",
            "tool"
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ],
          "description": "Plaintext rendering of the message. May be omitted for privacy."
        },
        "final_answer": {
          "type": "boolean",
          "description": "Explicit finalized assistant answer; true requires full text and command lineage."
        },
        "command_id": {
          "type": "string",
          "minLength": 1,
          "format": "uuid"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        },
        "target_agent_id": {
          "type": "string",
          "minLength": 1
        },
        "profile_name": {
          "type": "string",
          "minLength": 1
        },
        "command_event_id": {
          "type": "string",
          "minLength": 1,
          "format": "uuid"
        },
        "issuer": {
          "$ref": "../../_common/cloudevent_base.v1.json#/properties/actor",
          "description": "Exact issuing command actor, separate from the answering envelope actor."
        },
        "command_causationid": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "native_session_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Observed Hermes native identity, never synthesized from logical identifiers."
        },
        "native_turn_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Observed Hermes native identity, never synthesized from logical identifiers."
        }
      },
      "required": [
        "thread_id",
        "turn_id",
        "message_id",
        "role"
      ],
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "final_answer": {
                "const": true
              }
            },
            "required": [
              "final_answer"
            ]
          },
          "then": {
            "properties": {
              "role": {
                "const": "assistant"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "text",
              "command_id",
              "idempotency_key",
              "target_agent_id",
              "profile_name",
              "issuer",
              "command_event_id",
              "command_causationid"
            ]
          }
        }
      ]
    }
  },
  "required": [
    "type",
    "kind",
    "domain",
    "data"
  ]
}
