{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/review/feedback.send.json",
  "title": "Frozen walkthrough feedback send command",
  "description": "One explicitly sent immutable Holocene feedback submission. The gateway maps it internally through its dedicated opt-in feedback lane without publishing a second invocation command. Every retry retains the same envelope bytes and command_id; answered requires a matching native final assistant reply, not a queued/completed receipt.",
  "type": "object",
  "allOf": [{"$ref": "../../_common/cloudevent_base.v1.json"}],
  "properties": {
    "type": {"const": "bloodbank.review.feedback.send"},
    "kind": {"const": "command"},
    "domain": {"const": "review"},
    "subject": {"const": "bloodbank.cmd.review.feedback.send"},
    "source": {"const": "urn:33god:service:holocene-review-feedback"},
    "service": {"const": "holocene-review-feedback"},
    "producer": {"const": "holocene"},
    "dataschema": {"const": "apicurio://holyfields/bloodbank.review.feedback.send/versions/1"},
    "schemaref": {"const": "bloodbank.review.feedback.send.v1"},
    "delivery": {"const": "single_consumer"},
    "actor": {
      "type": "object",
      "properties": {"type": {"const": "operator"}, "agent_id": {"type": "string", "minLength": 1}},
      "required": ["type", "agent_id"], "additionalProperties": false
    },
    "data": {
      "type": "object",
      "properties": {
        "submissionId": {"type": "string", "format": "uuid"},
        "projectId": {"const": "greeninbetween"},
        "revisionId": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "artifactId": {"type": "string", "minLength": 1},
        "author": {"type": "string", "minLength": 1},
        "recipient": {"const": "green-in-between-pm"},
        "note": {"type": "string", "maxLength": 4000},
        "annotations": {
          "type": "array", "minItems": 1, "maxItems": 500,
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "version": {"type": "integer", "minimum": 1},
              "author": {"type": "string", "minLength": 1},
              "kind": {"enum": ["text", "element"]},
              "anchor": {"type": "object"},
              "comment": {"type": "string", "minLength": 1, "maxLength": 10000, "pattern": "\\S"},
              "updatedAt": {"type": "string", "format": "date-time"}
            },
            "required": ["id", "version", "author", "kind", "anchor", "comment", "updatedAt"],
            "additionalProperties": false
          }
        },
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "correlationId": {"type": "string", "format": "uuid"}
      },
      "required": ["submissionId", "projectId", "revisionId", "artifactId", "author", "recipient", "note", "annotations", "digest", "correlationId"],
      "additionalProperties": false
    }
  },
  "required": ["type", "kind", "domain", "subject", "actor", "data", "datacontenttype", "dataschema", "schemaref", "causationid", "command_id", "idempotency_key", "delivery"]
}
