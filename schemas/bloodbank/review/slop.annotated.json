{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/review/slop.annotated.json",
  "title": "Review Slop Annotated Event",
  "description": "An offline or sidecar reviewer classified an event payload as slop and annotated it with confidence and rationale.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.review.slop.annotated"
    },
    "kind": {
      "const": "event"
    },
    "domain": {
      "const": "review"
    },
    "data": {
      "type": "object",
      "description": "Payload for bloodbank.review.slop.annotated.",
      "properties": {
        "target_event_id": {
          "type": "string",
          "description": "The event ID of the tool call or payload evaluated."
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Agent session ID if present."
        },
        "cwd": {
          "type": [
            "string",
            "null"
          ],
          "description": "Working directory of the agent/tool when slop occurred."
        },
        "tool_name": {
          "type": "string",
          "description": "Name of the tool executed."
        },
        "arguments": {
          "type": [
            "object",
            "string",
            "null"
          ],
          "description": "Arguments passed to the tool."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Confidence score of the slop classification."
        },
        "reason": {
          "type": "string",
          "description": "Rationale for classifying the payload as slop."
        }
      },
      "required": [
        "target_event_id",
        "tool_name",
        "confidence",
        "reason"
      ]
    }
  },
  "required": [
    "type",
    "kind",
    "domain",
    "data"
  ]
}
