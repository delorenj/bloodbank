{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/telephony/call.recorded.json",
  "title": "Telephony Call Recorded Event",
  "description": "A recording of a call is available: a voicemail left for the operator, or a recorded conversation. Telnyx recording URLs expire about 10 minutes after the call; consumers that need the audio copy it at once. ordering_key is call:<call_id>. See bloodbank/docs/event-naming.md (telephony).",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.telephony.call.recorded"
    },
    "kind": {
      "const": "event"
    },
    "domain": {
      "const": "telephony"
    },
    "data": {
      "type": "object",
      "description": "Payload for bloodbank.telephony.call.recorded.",
      "properties": {
        "call_id": {
          "type": "string",
          "description": "Provider call identifier (Telnyx call_control_id or TeXML CallSid). Every event of one call carries the same value; ordering_key is call:<call_id>.",
          "minLength": 1
        },
        "recording_id": {
          "type": "string",
          "description": "Provider recording id.",
          "minLength": 1
        },
        "line": {
          "type": "string",
          "description": "The operator line involved: 'cell' (the personal Verizon line, forwarded from the Android phone), 'imessage' (the operator's iMessage account on the Mac, through BlueBubbles), or the E.164 of a Telnyx number.",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "description": "voicemail: a message left for the operator; call: a recorded conversation.",
          "enum": [
            "voicemail",
            "call"
          ]
        },
        "from": {
          "type": "string",
          "description": "Caller (E.164), or 'anonymous'.",
          "minLength": 1
        },
        "duration_seconds": {
          "type": "integer",
          "description": "Recording length.",
          "minimum": 0
        },
        "channels": {
          "type": "integer",
          "description": "1 (mono) or 2 (one channel per party).",
          "enum": [
            1,
            2
          ]
        },
        "recording_url": {
          "type": [
            "string",
            "null"
          ],
          "description": "Fetchable URL; may expire."
        },
        "url_expires_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "When recording_url stops working, if known."
        },
        "recorded_at": {
          "type": "string",
          "description": "When the recording finished.",
          "format": "date-time"
        }
      },
      "required": [
        "call_id",
        "recording_id",
        "line",
        "kind",
        "from",
        "duration_seconds",
        "recorded_at"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "type",
    "kind",
    "domain",
    "data"
  ]
}
