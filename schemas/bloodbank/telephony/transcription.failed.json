{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/telephony/transcription.failed.json",
  "title": "Telephony Transcription Failed Event",
  "description": "Speech-to-text of a call recording or voicemail failed or produced nothing. ordering_key is call:<call_id>. See bloodbank/docs/event-naming.md (telephony).",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.telephony.transcription.failed"
    },
    "kind": {
      "const": "event"
    },
    "domain": {
      "const": "telephony"
    },
    "data": {
      "type": "object",
      "description": "Payload for bloodbank.telephony.transcription.failed.",
      "properties": {
        "call_id": {
          "type": "string",
          "description": "Provider call identifier (Telnyx call_control_id or TeXML CallSid). Every event of one call carries the same value; ordering_key is call:<call_id>.",
          "minLength": 1
        },
        "recording_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "The recording, when known."
        },
        "line": {
          "type": "string",
          "description": "The operator line involved: 'cell' (the personal Verizon line, forwarded), or the E.164 of a Telnyx number.",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "description": "voicemail: a message left for the operator; call: a recorded conversation.",
          "enum": [
            "voicemail",
            "call"
          ]
        },
        "reason": {
          "type": "string",
          "description": "Why it failed."
        },
        "failed_at": {
          "type": "string",
          "description": "When the failure was reported.",
          "format": "date-time"
        }
      },
      "required": [
        "call_id",
        "line",
        "kind",
        "reason",
        "failed_at"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "type",
    "kind",
    "domain",
    "data"
  ]
}
