{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/telephony/call.ended.json",
  "title": "Telephony Call Ended Event",
  "description": "The call is over, with its disposition and duration. ordering_key is call:<call_id>. See bloodbank/docs/event-naming.md (telephony).",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.telephony.call.ended"
    },
    "kind": {
      "const": "event"
    },
    "domain": {
      "const": "telephony"
    },
    "data": {
      "type": "object",
      "description": "Payload for bloodbank.telephony.call.ended.",
      "properties": {
        "call_id": {
          "type": "string",
          "description": "Provider call identifier (Telnyx call_control_id or TeXML CallSid). Every event of one call carries the same value; ordering_key is call:<call_id>.",
          "minLength": 1
        },
        "line": {
          "type": "string",
          "description": "The operator line involved: 'cell' (the personal Verizon line, forwarded from the Android phone), 'imessage' (the operator's iMessage account on the Mac, through BlueBubbles), or the E.164 of a Telnyx number.",
          "minLength": 1
        },
        "direction": {
          "type": "string",
          "description": "inbound: a call to the operator's line; outbound: a call the operator's line placed.",
          "enum": [
            "inbound",
            "outbound"
          ]
        },
        "from": {
          "type": "string",
          "description": "Caller (E.164), or 'anonymous'.",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "description": "Called number (E.164).",
          "minLength": 1
        },
        "disposition": {
          "type": "string",
          "description": "How it ended.",
          "enum": [
            "answered",
            "voicemail",
            "missed",
            "busy",
            "no_answer",
            "rejected",
            "canceled",
            "failed"
          ]
        },
        "duration_seconds": {
          "type": "integer",
          "description": "Billable or connected duration.",
          "minimum": 0
        },
        "hangup_cause": {
          "type": [
            "string",
            "null"
          ],
          "description": "Provider hangup cause, e.g. normal_clearing."
        },
        "ended_at": {
          "type": "string",
          "description": "When the call ended.",
          "format": "date-time"
        },
        "cost": {
          "type": [
            "object",
            "null"
          ],
          "description": "Provider charge, when known.",
          "properties": {
            "amount": {
              "type": "string",
              "description": "Decimal amount as the provider reports it."
            },
            "currency": {
              "type": "string",
              "description": "ISO 4217 code.",
              "minLength": 3,
              "maxLength": 3
            }
          },
          "required": [
            "amount",
            "currency"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "call_id",
        "line",
        "direction",
        "from",
        "to",
        "disposition",
        "ended_at"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "type",
    "kind",
    "domain",
    "data"
  ]
}
