{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/telephony/transcription.completed.json",
  "title": "Telephony Transcription Completed Event",
  "description": "Speech-to-text of a call recording or voicemail finished. ordering_key is call:<call_id> (distinct from audio.transcription.* for inbox audio files). See bloodbank/docs/event-naming.md (telephony).",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.telephony.transcription.completed"
    },
    "kind": {
      "const": "event"
    },
    "domain": {
      "const": "telephony"
    },
    "data": {
      "type": "object",
      "description": "Payload for bloodbank.telephony.transcription.completed.",
      "properties": {
        "call_id": {
          "type": "string",
          "description": "Provider call identifier (Telnyx call_control_id or TeXML CallSid). Every event of one call carries the same value; ordering_key is call:<call_id>.",
          "minLength": 1
        },
        "recording_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "The recording transcribed, when the provider names it."
        },
        "line": {
          "type": "string",
          "description": "The operator line involved: 'cell' (the personal Verizon line, forwarded), or the E.164 of a Telnyx number.",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "description": "voicemail: a message left for the operator; call: a recorded conversation.",
          "enum": [
            "voicemail",
            "call"
          ]
        },
        "from": {
          "type": "string",
          "description": "Caller (E.164), or 'anonymous'.",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "description": "Transcript, with provider channel labels removed."
        },
        "engine": {
          "type": [
            "string",
            "null"
          ],
          "description": "Engine and model, e.g. deepgram/nova-3."
        },
        "language": {
          "type": [
            "string",
            "null"
          ],
          "description": "BCP-47 tag, e.g. en-US."
        },
        "completed_at": {
          "type": "string",
          "description": "When the transcript was delivered.",
          "format": "date-time"
        }
      },
      "required": [
        "call_id",
        "line",
        "kind",
        "from",
        "text",
        "completed_at"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "type",
    "kind",
    "domain",
    "data"
  ]
}
