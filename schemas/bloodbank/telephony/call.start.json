{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/telephony/call.start.json",
  "title": "Telephony Call Start Command",
  "description": "Imperative request to place an outbound call from one of the operator's Telnyx numbers. Give either say (text to speak, then hang up) or texml_url (instructions for the call). The executor answers with telephony.call.started, then telephony.call.ended, carrying this command_id. Recommended idempotency_key: 'telephony.call.start:<to>:<minute>'. See bloodbank/docs/event-naming.md (telephony).",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.telephony.call.start"
    },
    "kind": {
      "const": "command"
    },
    "domain": {
      "const": "telephony"
    },
    "delivery": {
      "const": "single_consumer"
    },
    "data": {
      "type": "object",
      "description": "Payload for bloodbank.telephony.call.start.",
      "properties": {
        "to": {
          "type": "string",
          "description": "Number to call (E.164).",
          "pattern": "^\\+[1-9][0-9]{6,14}$"
        },
        "from": {
          "type": [
            "string",
            "null"
          ],
          "description": "Calling Telnyx number (E.164); null uses the default line.",
          "pattern": "^\\+[1-9][0-9]{6,14}$"
        },
        "say": {
          "type": [
            "string",
            "null"
          ],
          "description": "Text to speak when answered."
        },
        "texml_url": {
          "type": [
            "string",
            "null"
          ],
          "description": "TeXML document URL that drives the call."
        },
        "record": {
          "type": "boolean",
          "description": "Record the call (emits telephony.call.recorded)."
        },
        "timeout_seconds": {
          "type": "integer",
          "description": "How long to ring before giving up.",
          "minimum": 5,
          "maximum": 120
        }
      },
      "required": [
        "to"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "type",
    "kind",
    "domain",
    "data",
    "delivery"
  ]
}
