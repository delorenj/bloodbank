{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/telephony/message.sent.json",
  "title": "Telephony Message Sent Event",
  "description": "A text message left one of the operator's lines: accepted by Telnyx for sending, or sent from the phone. Delivery outcome follows as telephony.message.completed or telephony.message.failed with the same message_id. ordering_key is line:<line>. See bloodbank/docs/event-naming.md (telephony).",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.telephony.message.sent"
    },
    "kind": {
      "const": "event"
    },
    "domain": {
      "const": "telephony"
    },
    "data": {
      "type": "object",
      "description": "Payload for bloodbank.telephony.message.sent.",
      "properties": {
        "message_id": {
          "type": "string",
          "description": "Provider message id (Telnyx) or <source>:<id>.",
          "minLength": 1
        },
        "line": {
          "type": "string",
          "description": "The operator line involved: 'cell' (the personal Verizon line, forwarded), or the E.164 of a Telnyx number.",
          "minLength": 1
        },
        "channel": {
          "type": "string",
          "description": "Transport the message arrived on or left by.",
          "enum": [
            "sms",
            "mms",
            "rcs",
            "imessage",
            "unknown"
          ]
        },
        "source": {
          "type": "string",
          "description": "Which integration observed the message.",
          "enum": [
            "telnyx",
            "android-sms",
            "android-notification",
            "bluebubbles",
            "phone",
            "other"
          ]
        },
        "from": {
          "type": "string",
          "description": "Sending number (E.164).",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "description": "Destination (E.164).",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "description": "Message body."
        },
        "sent_at": {
          "type": "string",
          "description": "When it was submitted.",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "description": "Provider status at submission.",
          "enum": [
            "queued",
            "sending",
            "sent"
          ]
        },
        "command_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "command_id of the telephony.message.send command that caused it, if any."
        },
        "cost": {
          "type": [
            "object",
            "null"
          ],
          "description": "Provider charge, when known.",
          "properties": {
            "amount": {
              "type": "string",
              "description": "Decimal amount as the provider reports it."
            },
            "currency": {
              "type": "string",
              "description": "ISO 4217 code.",
              "minLength": 3,
              "maxLength": 3
            }
          },
          "required": [
            "amount",
            "currency"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "message_id",
        "line",
        "channel",
        "source",
        "from",
        "to",
        "text",
        "sent_at"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "type",
    "kind",
    "domain",
    "data"
  ]
}
