{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/llm/allowance.observed.json",
  "title": "LLM Allowance Observed Event",
  "description": "A provider-reported subscription allowance window observation for one account.",
  "$comment": "Utilization is the provider-reported percentage or provider_used / provider_limit * 100 from matching provider quota units, never inferred from ledger or gateway token totals. Preserve original provider headers or body values without rewriting previously published facts. observation_id must be stable for the same provider observation; ordering is one bucket per account, window and optional limit. reset_at is null when the provider does not expose a reset time.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.llm.allowance.observed"
    },
    "kind": {
      "const": "event"
    },
    "domain": {
      "const": "llm"
    },
    "subject": {
      "const": "bloodbank.evt.llm.allowance.observed"
    },
    "schemaref": {
      "const": "bloodbank.llm.allowance.observed.v1"
    },
    "dataschema": {
      "const": "apicurio://holyfields/bloodbank.llm.allowance.observed/versions/1"
    },
    "ordering_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 449,
      "pattern": "^allowance:[a-z][a-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9._:-]{0,199}:(five_hour|daily|weekly|monthly|custom)(:[A-Za-z0-9._-]{1,128})?$",
      "description": "Account/window ordering bucket, optionally suffixed by the provider limit ID using 1-128 safe ASCII letters, digits, dots, underscores or hyphens. Legacy shared-account keys without a suffix remain valid, including limit_id=unified."
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "observation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "observed_at": {
          "$ref": "../../_common/types.v1.json#/$defs/timestamp"
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "account_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "limit_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          ]
        },
        "window": {
          "type": "string",
          "enum": [
            "five_hour",
            "daily",
            "weekly",
            "monthly",
            "custom"
          ],
          "description": "Preserve the existing named windows for matching provider durations. Use custom for other provider durations and window_seconds when the exact duration is known."
        },
        "window_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "Exact provider-reported window duration in seconds, when available."
        },
        "quota_unit": {
          "type": "string",
          "enum": [
            "tokens",
            "requests",
            "credits",
            "tool_calls"
          ],
          "description": "Matching provider quota unit for any reported limit, used or remaining amount. This is not ledger-derived gateway usage."
        },
        "quota_limit": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Provider-reported quota limit in quota_unit; omit when unavailable."
        },
        "quota_used": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Provider-reported used quota in quota_unit; omit when unavailable."
        },
        "quota_remaining": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Provider-reported remaining quota in quota_unit. May be reported without quota_limit or quota_used."
        },
        "applies_to": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^automaticai/(?!\\.{1,2}/)[A-Za-z0-9._:~+-]+(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9._:~+-]+)+$"
          },
          "description": "Canonical AutomaticAI gateway route IDs covered by this limit, never aliases or wildcard scopes. An empty array means the allowance is shared across the account."
        },
        "utilization_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Provider-reported utilization or provider_used / provider_limit * 100 in matching quota units. Never infer this percentage from ledger token counts."
        },
        "reset_at": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "../../_common/types.v1.json#/$defs/timestamp"
            }
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "response_header",
            "response_body"
          ]
        },
        "request_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          ]
        },
        "route": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          ]
        },
        "native_model": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          ]
        }
      },
      "dependentRequired": {
        "quota_limit": [
          "quota_unit"
        ],
        "quota_used": [
          "quota_unit"
        ],
        "quota_remaining": [
          "quota_unit"
        ]
      },
      "required": [
        "schema_version",
        "observation_id",
        "observed_at",
        "provider",
        "account_id",
        "limit_id",
        "window",
        "utilization_percent",
        "reset_at",
        "source",
        "request_id",
        "route",
        "native_model"
      ]
    }
  },
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "subject",
    "time",
    "datacontenttype",
    "dataschema",
    "correlationid",
    "causationid",
    "producer",
    "service",
    "domain",
    "kind",
    "schemaref",
    "actor",
    "ordering_key",
    "data"
  ]
}
