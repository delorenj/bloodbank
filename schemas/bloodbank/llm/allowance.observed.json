{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/llm/allowance.observed.json",
  "title": "LLM Allowance Observed Event",
  "description": "A provider-reported subscription allowance window observation for one account.",
  "$comment": "Gauge utilization comes from the provider, not from gateway token arithmetic: the same account can consume outside this gateway and providers do not publish token budgets. observation_id must be stable for the same provider observation; ordering is one bucket per account and window. reset_at is null when the provider does not expose a reset time.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.llm.allowance.observed"
    },
    "kind": {
      "const": "event"
    },
    "domain": {
      "const": "llm"
    },
    "subject": {
      "const": "bloodbank.evt.llm.allowance.observed"
    },
    "schemaref": {
      "const": "bloodbank.llm.allowance.observed.v1"
    },
    "dataschema": {
      "const": "apicurio://holyfields/bloodbank.llm.allowance.observed/versions/1"
    },
    "ordering_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 320,
      "pattern": "^allowance:[a-z][a-z0-9_.-]{0,63}:[A-Za-z0-9][A-Za-z0-9._:-]{0,199}:(five_hour|daily|weekly|monthly)$"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "observation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "observed_at": {
          "$ref": "../../_common/types.v1.json#/$defs/timestamp"
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "account_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "limit_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          ]
        },
        "window": {
          "type": "string",
          "enum": [
            "five_hour",
            "daily",
            "weekly",
            "monthly"
          ]
        },
        "utilization_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "reset_at": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "../../_common/types.v1.json#/$defs/timestamp"
            }
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "response_header",
            "response_body"
          ]
        },
        "request_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          ]
        },
        "route": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          ]
        },
        "native_model": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "observation_id",
        "observed_at",
        "provider",
        "account_id",
        "limit_id",
        "window",
        "utilization_percent",
        "reset_at",
        "source",
        "request_id",
        "route",
        "native_model"
      ]
    }
  },
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "subject",
    "time",
    "datacontenttype",
    "dataschema",
    "correlationid",
    "causationid",
    "producer",
    "service",
    "domain",
    "kind",
    "schemaref",
    "actor",
    "ordering_key",
    "data"
  ]
}
