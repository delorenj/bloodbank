{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/llm/usage.recorded.json",
  "title": "LLM Usage Recorded Event",
  "description": "One settled AutomaticAI gateway request, successful or failed, normalized for subscription and agent observability.",
  "$comment": "The gateway ledger is authoritative for this fact. usage_id must be stable across exporter retries and backfill; the envelope id should be UUIDv5 derived from the gateway identity. usage.input_tokens is the normalized total input (uncached plus cache reads and writes), matching OpenTelemetry gen_ai.usage.input_tokens semantics; the component counts preserve NewAPI accounting. Prompts, prompt hashes, proof markers and credentials are forbidden.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.llm.usage.recorded"
    },
    "kind": {
      "const": "event"
    },
    "domain": {
      "const": "llm"
    },
    "subject": {
      "const": "bloodbank.evt.llm.usage.recorded"
    },
    "schemaref": {
      "const": "bloodbank.llm.usage.recorded.v1"
    },
    "dataschema": {
      "const": "apicurio://holyfields/bloodbank.llm.usage.recorded/versions/1"
    },
    "ordering_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 320,
      "pattern": "^usage:[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "usage_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "gateway_log_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "occurred_at": {
          "$ref": "../../_common/types.v1.json#/$defs/timestamp"
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "account_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "billing_class": {
          "type": "string",
          "enum": [
            "subscription",
            "metered"
          ]
        },
        "route": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "requested_model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "native_model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "returned_model": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          ]
        },
        "requested_effort": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "enum": [
                "medium",
                "high",
                "xhigh",
                "max"
              ]
            }
          ]
        },
        "effective_effort": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "enum": [
                "medium",
                "high",
                "xhigh",
                "max"
              ]
            }
          ]
        },
        "effort_defaulted": {
          "type": "boolean"
        },
        "consumer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "gateway_token"
            },
            "token_id": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "token_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "agent": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                }
              ]
            }
          },
          "required": [
            "kind",
            "token_id",
            "token_name",
            "agent"
          ]
        },
        "session_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 8,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
            }
          ]
        },
        "project_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
            }
          ]
        },
        "request_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "stream": {
          "type": "boolean"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "completed",
            "incomplete",
            "failed"
          ]
        },
        "status_code": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "time_to_first_token_ms": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          ]
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "input_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "uncached_input_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "cache_read_input_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "cache_write_input_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "reasoning_output_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "input_tokens",
            "uncached_input_tokens",
            "cache_read_input_tokens",
            "cache_write_input_tokens",
            "output_tokens",
            "reasoning_output_tokens"
          ]
        }
      },
      "required": [
        "schema_version",
        "usage_id",
        "gateway_log_id",
        "request_id",
        "occurred_at",
        "provider",
        "account_id",
        "billing_class",
        "route",
        "requested_model",
        "native_model",
        "returned_model",
        "requested_effort",
        "effective_effort",
        "effort_defaulted",
        "consumer",
        "session_id",
        "project_id",
        "request_path",
        "stream",
        "outcome",
        "status_code",
        "latency_ms",
        "time_to_first_token_ms",
        "usage"
      ]
    }
  },
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "subject",
    "time",
    "datacontenttype",
    "dataschema",
    "correlationid",
    "causationid",
    "producer",
    "service",
    "domain",
    "kind",
    "schemaref",
    "actor",
    "ordering_key",
    "data"
  ]
}
