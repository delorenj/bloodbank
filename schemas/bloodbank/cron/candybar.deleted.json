{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/cron/candybar.deleted.json",
  "title": "Cron Candybar Deleted Event",
  "description": "A candybar was really deleted, not archived or paused. Producer commits active removal, retained identity/history/dedupe, and stable-ID durable outbox atomically before publication; retries reuse the envelope UUID.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.cron.candybar.deleted"
    },
    "kind": {
      "const": "event"
    },
    "domain": {
      "const": "cron"
    },
    "subject": {
      "const": "bloodbank.evt.cron.candybar.deleted"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "dataschema": {
      "const": "apicurio://holyfields/bloodbank.cron.candybar.deleted/versions/1"
    },
    "schemaref": {
      "const": "bloodbank.cron.candybar.deleted.v1"
    },
    "ordering_key": {
      "type": "string",
      "pattern": "^candybar:.+$",
      "description": "candybar:<candybar_id> \u2014 every lifecycle fact of one candybar shares this bucket."
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "candybar_id": {
          "$ref": "../../_common/types.v1.json#/$defs/uuid"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
          "description": "Unique lowercase slug."
        },
        "deleted_at": {
          "$ref": "../../_common/types.v1.json#/$defs/timestamp",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|\\+00:00)$",
          "description": "Real UTC RFC3339 deletion time; non-UTC and unknown offsets are forbidden."
        },
        "reason": {
          "type": "string",
          "enum": [
            "manual",
            "schedule_exhausted"
          ]
        },
        "last_invocation_id": {
          "oneOf": [
            {
              "$ref": "../../_common/types.v1.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ],
          "description": "Last invocation UUID, or explicit null if none; always present."
        }
      },
      "required": [
        "schema_version",
        "candybar_id",
        "name",
        "deleted_at",
        "reason",
        "last_invocation_id"
      ]
    }
  },
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "subject",
    "time",
    "datacontenttype",
    "dataschema",
    "correlationid",
    "causationid",
    "producer",
    "service",
    "kind",
    "domain",
    "schemaref",
    "actor",
    "ordering_key",
    "data"
  ]
}
