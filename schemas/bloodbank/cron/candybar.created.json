{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/cron/candybar.created.json",
  "title": "Cron Candybar Created Event",
  "description": "A candybar registration fact: preserved cron revision 1 or governed finite-only revision 2. Routing is unchanged; schema handles must agree with data.schema_version.",
  "type": "object",
  "properties": {
    "type": {
      "const": "bloodbank.cron.candybar.created"
    },
    "kind": {
      "const": "event"
    },
    "domain": {
      "const": "cron"
    },
    "subject": {
      "const": "bloodbank.evt.cron.candybar.created"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "ordering_key": {
      "type": "string",
      "pattern": "^candybar:.+$",
      "description": "candybar:<candybar_id> \u2014 every lifecycle fact of one candybar shares this bucket."
    }
  },
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "subject",
    "time",
    "datacontenttype",
    "dataschema",
    "correlationid",
    "causationid",
    "producer",
    "service",
    "kind",
    "domain",
    "schemaref",
    "actor",
    "ordering_key",
    "data"
  ],
  "oneOf": [
    {
      "title": "CronRegistrationV1",
      "properties": {
        "type": {
          "const": "bloodbank.cron.candybar.created"
        },
        "kind": {
          "const": "event"
        },
        "domain": {
          "const": "cron"
        },
        "subject": {
          "const": "bloodbank.evt.cron.candybar.created"
        },
        "datacontenttype": {
          "const": "application/json"
        },
        "ordering_key": {
          "type": "string",
          "pattern": "^candybar:.+$",
          "description": "candybar:<candybar_id> \u2014 every lifecycle fact of one candybar shares this bucket."
        },
        "dataschema": {
          "const": "apicurio://holyfields/bloodbank.cron.candybar.created/versions/1"
        },
        "schemaref": {
          "const": "bloodbank.cron.candybar.created.v1"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": {
              "const": 1
            },
            "candybar_id": {
              "$ref": "../../_common/types.v1.json#/$defs/uuid"
            },
            "name": {
              "type": "string",
              "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
              "description": "Unique lowercase slug."
            },
            "description": {
              "type": "string"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "schedule": {
              "type": "string",
              "minLength": 1,
              "description": "Standard 5-field cron expression, evaluated as local wall time in `timezone`."
            },
            "timezone": {
              "type": "string",
              "minLength": 1,
              "default": "UTC",
              "description": "IANA timezone name the schedule is read in (e.g. America/New_York). Optional and additive: facts published before it existed read as UTC. Every timestamp in the event stays UTC."
            },
            "noise": {
              "type": "boolean",
              "description": "Noise flag from the manifest; noisy candybars are hidden from default views."
            },
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "Whether the candybar is dispatched. A migration cutover registers it disabled and enables it once the job's native scheduler is retired. Optional and additive: facts published before it existed read as enabled."
            }
          },
          "required": [
            "schema_version",
            "candybar_id",
            "name",
            "description",
            "tags",
            "schedule",
            "noise"
          ]
        }
      },
      "allOf": [
        {
          "$ref": "../../_common/cloudevent_base.v1.json"
        }
      ],
      "required": [
        "specversion",
        "id",
        "source",
        "type",
        "subject",
        "time",
        "datacontenttype",
        "dataschema",
        "correlationid",
        "causationid",
        "producer",
        "service",
        "kind",
        "domain",
        "schemaref",
        "actor",
        "ordering_key",
        "data"
      ]
    },
    {
      "title": "FiniteRegistrationV2",
      "properties": {
        "type": {
          "const": "bloodbank.cron.candybar.created"
        },
        "kind": {
          "const": "event"
        },
        "domain": {
          "const": "cron"
        },
        "subject": {
          "const": "bloodbank.evt.cron.candybar.created"
        },
        "datacontenttype": {
          "const": "application/json"
        },
        "ordering_key": {
          "type": "string",
          "pattern": "^candybar:.+$",
          "description": "candybar:<candybar_id> \u2014 every lifecycle fact of one candybar shares this bucket."
        },
        "dataschema": {
          "const": "apicurio://holyfields/bloodbank.cron.candybar.created/versions/2"
        },
        "schemaref": {
          "const": "bloodbank.cron.candybar.created.v2"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": {
              "const": 2
            },
            "candybar_id": {
              "$ref": "../../_common/types.v1.json#/$defs/uuid"
            },
            "name": {
              "type": "string",
              "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
              "description": "Unique lowercase slug."
            },
            "description": {
              "type": "string"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "timezone": {
              "type": "string",
              "minLength": 1,
              "description": "Actual IANA timezone, checked with local zoneinfo at runtime. Wall-time representation only; DST resolution is owner-governed.",
              "examples": [
                "America/New_York"
              ]
            },
            "noise": {
              "type": "boolean",
              "description": "Noise flag from the manifest; noisy candybars are hidden from default views."
            },
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "Whether the candybar is dispatched. A migration cutover registers it disabled and enables it once the job's native scheduler is retired. Optional and additive: facts published before it existed read as enabled."
            },
            "dates": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:00)?$"
              },
              "description": "Real local calendar minutes, no offsets or fractions; equivalent minute and :00 spellings are duplicates. Semantic checks live in assert_cron_invariants."
            }
          },
          "required": [
            "schema_version",
            "candybar_id",
            "name",
            "description",
            "tags",
            "noise",
            "dates",
            "timezone"
          ]
        }
      },
      "allOf": [
        {
          "$ref": "../../_common/cloudevent_base.v1.json"
        }
      ],
      "required": [
        "specversion",
        "id",
        "source",
        "type",
        "subject",
        "time",
        "datacontenttype",
        "dataschema",
        "correlationid",
        "causationid",
        "producer",
        "service",
        "kind",
        "domain",
        "schemaref",
        "actor",
        "ordering_key",
        "data"
      ]
    }
  ]
}
