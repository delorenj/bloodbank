{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/billing/invoice.denied.json",
  "title": "Billing Invoice Denied",
  "description": "A Farm invoice command was refused: it failed verification (bad signature, expired, malformed, an actor the ledger does not allow: nothing was written to the ledger) or an allow-listed invoicer's request was refused by policy or the issue gate (recorded as farm.command.handled). Carries the command_id and the stable refusal code. Emitted by milkshake-farm-consumer. See bloodbank/docs/event-naming.md (billing).",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.billing.invoice.denied"
    },
    "kind": {
      "const": "event"
    },
    "domain": {
      "const": "billing"
    },
    "subject": {
      "const": "bloodbank.evt.billing.invoice.denied"
    },
    "schemaref": {
      "const": "bloodbank.billing.invoice.denied.v1"
    },
    "dataschema": {
      "const": "apicurio://holyfields/bloodbank.billing.invoice.denied/versions/1"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "description": "Payload for bloodbank.billing.invoice.denied.",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "command_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "client": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 64,
          "description": "Null while the command is unverified."
        },
        "period_start": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "period_end": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "description": "Exclusive."
        },
        "mode": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "plan",
            "apply",
            null
          ]
        },
        "status": {
          "const": "refused"
        },
        "code": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "description": "The refusal or failure code (docs/farm-commands.md section 10); on a plan, the refusal an apply would hit."
        },
        "message": {
          "type": "string",
          "maxLength": 500,
          "description": "One line: no paths, no secrets."
        },
        "number": {
          "type": [
            "string",
            "null"
          ],
          "description": "The statement number, planned or issued."
        },
        "total_cents": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "blocking_count": {
          "type": "integer",
          "minimum": 0
        },
        "warning_count": {
          "type": "integer",
          "minimum": 0
        },
        "requested_by": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 254,
          "description": "The ledger-verified invoicer; null when the command was refused before that was proven."
        },
        "claimed_requested_by": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 254,
          "description": "The unverified claim in a refused command; null otherwise."
        },
        "ledger_recorded": {
          "type": "boolean",
          "description": "Whether the outcome is a farm.command.handled on the ledger."
        },
        "ledger_seq": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "pushed": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether the snapshot carrying the outcome reached the Farm; null when no push was attempted (a re-published outcome)."
        },
        "snapshot_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "schema_version",
        "command_id",
        "client",
        "period_start",
        "period_end",
        "mode",
        "status",
        "code",
        "message",
        "number",
        "total_cents",
        "blocking_count",
        "warning_count",
        "requested_by",
        "claimed_requested_by",
        "ledger_recorded",
        "ledger_seq",
        "pushed",
        "snapshot_sha256"
      ]
    }
  },
  "required": [
    "type",
    "kind",
    "domain",
    "subject",
    "schemaref",
    "dataschema",
    "ordering_key",
    "causationid",
    "actor",
    "data"
  ]
}
