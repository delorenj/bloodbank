{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/billing/cost.recorded.json",
  "title": "Billing Cost Recorded",
  "description": "A vendor cost observation (a boi) was recorded on the Milkshake ledger, by a vendor reader or by hand (ledger boi.recorded). Legacy imports are never announced. Unknown money is null. Carries no evidence. Distinct from cost.observed, the portal's provider snapshot. Emitted by the milkshake-outbox after the ledger commit. See bloodbank/docs/event-naming.md (billing).",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "required": [
    "type",
    "kind",
    "domain",
    "subject",
    "schemaref",
    "dataschema",
    "ordering_key",
    "causationid",
    "actor",
    "data"
  ],
  "properties": {
    "type": {
      "const": "bloodbank.billing.cost.recorded"
    },
    "kind": {
      "const": "event"
    },
    "domain": {
      "const": "billing"
    },
    "subject": {
      "const": "bloodbank.evt.billing.cost.recorded"
    },
    "schemaref": {
      "const": "bloodbank.billing.cost.recorded.v1"
    },
    "dataschema": {
      "const": "apicurio://holyfields/bloodbank.billing.cost.recorded/versions/1"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "description": "Payload for bloodbank.billing.cost.recorded.",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "client": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 64,
          "description": "Client slug, or null for a ledger fact of no client."
        },
        "ledger_seq": {
          "type": "integer",
          "minimum": 1,
          "description": "Seq of the ledger event this announces."
        },
        "ledger_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Hash of that ledger event; the CloudEvent id is a uuid5 of it, so a re-publish is the same event."
        },
        "ledger_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "The ledger event type, e.g. rule.added."
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Who recorded it (MILKSHAKE_ACTOR, or farm:<email>)."
        },
        "boi_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "vendor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "period_start": {
          "type": "string",
          "format": "date"
        },
        "period_end": {
          "type": "string",
          "format": "date",
          "description": "Exclusive."
        },
        "amount_cents": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Vendor cost in integer cents; null when unknown, never 0."
        },
        "cost_type": {
          "enum": [
            "actual",
            "estimate"
          ]
        },
        "coverage": {
          "enum": [
            "complete",
            "partial",
            "unavailable",
            "unattributed"
          ]
        },
        "source_kind": {
          "enum": [
            "api",
            "manual",
            "fixture"
          ]
        }
      },
      "required": [
        "schema_version",
        "client",
        "ledger_seq",
        "ledger_hash",
        "ledger_type",
        "actor",
        "boi_id",
        "vendor",
        "category",
        "period_start",
        "period_end",
        "amount_cents",
        "cost_type",
        "coverage",
        "source_kind"
      ]
    }
  }
}
