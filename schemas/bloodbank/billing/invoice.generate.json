{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/billing/invoice.generate.json",
  "title": "Billing Invoice Generate Command",
  "description": "Imperative request, from an authenticated Farm (client portal) operator, that the billing authority (Milkshake) plan or issue a customer statement for one client and period. Signed by the portal Worker (HMAC-SHA256) and accepted by farm-command-bridge; the consumer re-verifies the signature, checks its own allow-list of invoicers and answers with billing.invoice.generated, .denied or .failed carrying this command_id. Recommended idempotency_key: 'billing.invoice.generate:client:<client>:command:<command_id>'. See bloodbank/docs/event-naming.md (billing) and Milkshake docs/farm-commands.md.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.billing.invoice.generate"
    },
    "kind": {
      "const": "command"
    },
    "domain": {
      "const": "billing"
    },
    "subject": {
      "const": "bloodbank.cmd.billing.invoice.generate"
    },
    "schemaref": {
      "const": "bloodbank.billing.invoice.generate.v1"
    },
    "dataschema": {
      "const": "apicurio://holyfields/bloodbank.billing.invoice.generate/versions/1"
    },
    "delivery": {
      "const": "single_consumer"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "description": "Payload for bloodbank.billing.invoice.generate.",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "request": {
          "type": "object",
          "description": "The request the portal Worker signed, exactly as signed: every key present, an unused one null. The signature covers its canonical JSON (docs/farm-commands.md section 2).",
          "additionalProperties": false,
          "properties": {
            "schema_version": {
              "const": 1
            },
            "command_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "description": "uuid5(NS_FARM_COMMAND, session_id + ':' + client_request_id); equals the envelope command_id."
            },
            "client_request_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "description": "A nonce the browser mints once per dialog submit; a retry of the same submit reuses it."
            },
            "client": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "maxLength": 64
            },
            "period": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
            },
            "date_from": {
              "type": [
                "string",
                "null"
              ],
              "format": "date",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "date_to": {
              "type": [
                "string",
                "null"
              ],
              "format": "date",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "description": "Inclusive."
            },
            "mode": {
              "type": "string",
              "enum": [
                "plan",
                "apply"
              ]
            },
            "accept_incomplete_reason": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 500
            },
            "approved_by": {
              "type": [
                "string",
                "null"
              ],
              "description": "The requester when a reason is given, else null; set by the Worker, never the browser."
            },
            "requested_by": {
              "type": "string",
              "pattern": "^[a-z0-9._%+'-]+@[a-z0-9-]+(\\.[a-z0-9-]+)+$",
              "maxLength": 254,
              "description": "The verified session email, trimmed and lowercased."
            },
            "session_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "The auth session row id, never the session token."
            },
            "issued_at": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$",
              "description": "The Worker clock."
            }
          },
          "required": [
            "schema_version",
            "command_id",
            "client_request_id",
            "client",
            "period",
            "date_from",
            "date_to",
            "mode",
            "accept_incomplete_reason",
            "approved_by",
            "requested_by",
            "session_id",
            "issued_at"
          ]
        },
        "signature": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "alg": {
              "const": "hmac-sha256"
            },
            "key_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "value": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "description": "Lowercase hex HMAC-SHA256 over the canonical JSON bytes of request."
            }
          },
          "required": [
            "alg",
            "key_id",
            "value"
          ]
        },
        "body_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "sha256 of the signed bytes."
        },
        "received_at": {
          "type": "string",
          "format": "date-time",
          "description": "When the bridge accepted it; equals the envelope time."
        }
      },
      "required": [
        "schema_version",
        "request",
        "signature",
        "body_sha256",
        "received_at"
      ]
    }
  },
  "required": [
    "type",
    "kind",
    "domain",
    "subject",
    "schemaref",
    "dataschema",
    "command_id",
    "idempotency_key",
    "actor",
    "data",
    "delivery"
  ]
}
