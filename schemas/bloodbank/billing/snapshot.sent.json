{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/billing/snapshot.sent.json",
  "title": "Billing Snapshot Sent",
  "description": "A milkshake/v1 snapshot was accepted by the Farm (the client portal) and recorded on the Milkshake ledger (ledger farm.pushed). duplicate is the portal's flag: it already held these bytes. Never the token or the body. Emitted by the milkshake-outbox after the ledger commit. See bloodbank/docs/event-naming.md (billing).",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "required": [
    "type",
    "kind",
    "domain",
    "subject",
    "schemaref",
    "dataschema",
    "ordering_key",
    "causationid",
    "actor",
    "data"
  ],
  "properties": {
    "type": {
      "const": "bloodbank.billing.snapshot.sent"
    },
    "kind": {
      "const": "event"
    },
    "domain": {
      "const": "billing"
    },
    "subject": {
      "const": "bloodbank.evt.billing.snapshot.sent"
    },
    "schemaref": {
      "const": "bloodbank.billing.snapshot.sent.v1"
    },
    "dataschema": {
      "const": "apicurio://holyfields/bloodbank.billing.snapshot.sent/versions/1"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "description": "Payload for bloodbank.billing.snapshot.sent.",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "client": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 64,
          "description": "Client slug, or null for a ledger fact of no client."
        },
        "ledger_seq": {
          "type": "integer",
          "minimum": 1,
          "description": "Seq of the ledger event this announces."
        },
        "ledger_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Hash of that ledger event; the CloudEvent id is a uuid5 of it, so a re-publish is the same event."
        },
        "ledger_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "The ledger event type, e.g. rule.added."
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Who recorded it (MILKSHAKE_ACTOR, or farm:<email>)."
        },
        "payload_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "duplicate": {
          "type": "boolean"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "ledger_head_seq": {
          "type": "integer",
          "minimum": 0,
          "description": "The ledger head the snapshot was built at."
        },
        "yrd_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "schema_version",
        "client",
        "ledger_seq",
        "ledger_hash",
        "ledger_type",
        "actor",
        "payload_sha256",
        "duplicate",
        "size_bytes",
        "ledger_head_seq",
        "yrd_count"
      ]
    }
  }
}
