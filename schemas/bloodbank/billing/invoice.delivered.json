{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/billing/invoice.delivered.json",
  "title": "Billing Invoice Delivered",
  "description": "An issued statement was raised on a delivery rail (Mercury accounts receivable) and recorded on the Milkshake ledger (ledger yrd.delivered). send_email says whether the rail emailed the client. Emitted by the milkshake-outbox after the ledger commit. See bloodbank/docs/event-naming.md (billing).",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "required": [
    "type",
    "kind",
    "domain",
    "subject",
    "schemaref",
    "dataschema",
    "ordering_key",
    "causationid",
    "actor",
    "data"
  ],
  "properties": {
    "type": {
      "const": "bloodbank.billing.invoice.delivered"
    },
    "kind": {
      "const": "event"
    },
    "domain": {
      "const": "billing"
    },
    "subject": {
      "const": "bloodbank.evt.billing.invoice.delivered"
    },
    "schemaref": {
      "const": "bloodbank.billing.invoice.delivered.v1"
    },
    "dataschema": {
      "const": "apicurio://holyfields/bloodbank.billing.invoice.delivered/versions/1"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "description": "Payload for bloodbank.billing.invoice.delivered.",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "client": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 64,
          "description": "Client slug, or null for a ledger fact of no client."
        },
        "ledger_seq": {
          "type": "integer",
          "minimum": 1,
          "description": "Seq of the ledger event this announces."
        },
        "ledger_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Hash of that ledger event; the CloudEvent id is a uuid5 of it, so a re-publish is the same event."
        },
        "ledger_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "The ledger event type, e.g. rule.added."
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Who recorded it (MILKSHAKE_ACTOR, or farm:<email>)."
        },
        "number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "rail": {
          "enum": [
            "mercury"
          ]
        },
        "delivery_kind": {
          "enum": [
            "full",
            "delta"
          ]
        },
        "amount_cents": {
          "type": "integer",
          "minimum": 1
        },
        "send_email": {
          "type": "boolean"
        },
        "external_number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "schema_version",
        "client",
        "ledger_seq",
        "ledger_hash",
        "ledger_type",
        "actor",
        "number",
        "rail",
        "delivery_kind",
        "amount_cents",
        "send_email",
        "external_number"
      ]
    }
  }
}
