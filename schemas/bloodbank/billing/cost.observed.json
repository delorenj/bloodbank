{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/billing/cost.observed.json",
  "title": "Billing Cost Observed",
  "description": "An immutable revision of a scoped cost snapshot. Revisions replace snapshots; they are never additive usage samples. Unknown money is null.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.billing.cost.observed"
    },
    "kind": {
      "const": "event"
    },
    "domain": {
      "const": "billing"
    },
    "subject": {
      "const": "bloodbank.evt.billing.cost.observed"
    },
    "schemaref": {
      "const": "bloodbank.billing.cost.observed.v1"
    },
    "dataschema": {
      "const": "apicurio://holyfields/bloodbank.billing.cost.observed/versions/1"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "client_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "account_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "resource_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "period_start": {
          "type": "string",
          "format": "date"
        },
        "period_end": {
          "type": "string",
          "format": "date"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "as_of": {
          "type": "string",
          "format": "date-time"
        },
        "cost_key": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "amount_micros": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "cost_type": {
          "type": "string",
          "enum": [
            "actual",
            "estimate",
            "balance",
            "usage"
          ]
        },
        "payer": {
          "type": "string",
          "enum": [
            "automaticai",
            "client",
            "unknown"
          ]
        },
        "environment": {
          "type": "string",
          "enum": [
            "production",
            "staging",
            "development",
            "shared",
            "unknown"
          ]
        },
        "category": {
          "type": "string",
          "enum": [
            "infrastructure",
            "telephony",
            "speech",
            "llm",
            "analytics",
            "other"
          ]
        },
        "allocation": {
          "type": "string",
          "enum": [
            "direct",
            "manual",
            "unallocated"
          ]
        },
        "coverage": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "unavailable",
            "unattributed"
          ]
        },
        "coverage_reason": {
          "type": "string",
          "maxLength": 500
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "api",
                "manual",
                "fixture"
              ]
            },
            "reference": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "evidence_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "evidence": {
              "type": "string",
              "maxLength": 16000
            },
            "recorded_by": {
              "type": "string",
              "maxLength": 200
            }
          },
          "required": [
            "kind",
            "reference",
            "evidence_sha256"
          ]
        }
      },
      "required": [
        "schema_version",
        "client_id",
        "project_id",
        "provider",
        "account_id",
        "resource_id",
        "period_start",
        "period_end",
        "observed_at",
        "as_of",
        "cost_key",
        "revision",
        "amount_micros",
        "currency",
        "cost_type",
        "payer",
        "environment",
        "category",
        "allocation",
        "coverage",
        "coverage_reason",
        "description",
        "source"
      ]
    }
  },
  "required": [
    "subject",
    "schemaref",
    "dataschema",
    "ordering_key",
    "causationid",
    "actor"
  ]
}
