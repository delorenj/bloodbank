{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/billing/rule.revoked.json",
  "title": "Billing Rule Revoked",
  "description": "A rule was revoked on the Milkshake ledger (ledger rule.revoked); the original rule.added stays on the ledger. Emitted by the milkshake-outbox after the ledger commit. See bloodbank/docs/event-naming.md (billing).",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "required": [
    "type",
    "kind",
    "domain",
    "subject",
    "schemaref",
    "dataschema",
    "ordering_key",
    "causationid",
    "actor",
    "data"
  ],
  "properties": {
    "type": {
      "const": "bloodbank.billing.rule.revoked"
    },
    "kind": {
      "const": "event"
    },
    "domain": {
      "const": "billing"
    },
    "subject": {
      "const": "bloodbank.evt.billing.rule.revoked"
    },
    "schemaref": {
      "const": "bloodbank.billing.rule.revoked.v1"
    },
    "dataschema": {
      "const": "apicurio://holyfields/bloodbank.billing.rule.revoked/versions/1"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "description": "Payload for bloodbank.billing.rule.revoked.",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "client": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 64,
          "description": "Client slug, or null for a ledger fact of no client."
        },
        "ledger_seq": {
          "type": "integer",
          "minimum": 1,
          "description": "Seq of the ledger event this announces."
        },
        "ledger_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Hash of that ledger event; the CloudEvent id is a uuid5 of it, so a re-publish is the same event."
        },
        "ledger_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "The ledger event type, e.g. rule.added."
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Who recorded it (MILKSHAKE_ACTOR, or farm:<email>)."
        },
        "rule_id": {
          "type": "string",
          "pattern": "^r[0-9]+$"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        }
      },
      "required": [
        "schema_version",
        "client",
        "ledger_seq",
        "ledger_hash",
        "ledger_type",
        "actor",
        "rule_id",
        "reason"
      ]
    }
  }
}
