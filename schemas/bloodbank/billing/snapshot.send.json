{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/billing/snapshot.send.json",
  "title": "Billing Snapshot Send Command",
  "description": "Imperative request, from a Farm operator through the command palette, that the billing authority build a client's milkshake/v1 snapshot and, on an apply, post it to the Farm (ms farm push). Signed by the portal Worker (HMAC-SHA256, a farm-command-* key) and accepted by farm-command-bridge at POST /v1/commands; the consumer re-verifies the signature, checks the sender's per-client grant on its own ledger and answers with billing.farm_command.completed, .denied or .failed carrying this command_id. Recommended idempotency_key: 'billing.snapshot.send:client:<client>:command:<command_id>'. See bloodbank/docs/event-naming.md (billing) and Milkshake docs/farm-commands.md section 14.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.billing.snapshot.send"
    },
    "kind": {
      "const": "command"
    },
    "domain": {
      "const": "billing"
    },
    "subject": {
      "const": "bloodbank.cmd.billing.snapshot.send"
    },
    "schemaref": {
      "const": "bloodbank.billing.snapshot.send.v1"
    },
    "dataschema": {
      "const": "apicurio://holyfields/bloodbank.billing.snapshot.send/versions/1"
    },
    "delivery": {
      "const": "single_consumer"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^billing\\.snapshot\\.send:client:[a-z0-9]+(-[a-z0-9]+)*:command:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "data": {
      "allOf": [
        {
          "$ref": "../../_common/farm_command_request.v1.json#/$defs/palette_data"
        }
      ],
      "description": "Payload for bloodbank.billing.snapshot.send.",
      "properties": {
        "request": {
          "allOf": [
            {
              "$ref": "../../_common/farm_command_request.v1.json#/$defs/palette_request"
            }
          ],
          "properties": {
            "subject": {
              "const": "bloodbank.cmd.billing.snapshot.send"
            },
            "command": {
              "const": "farm push"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "client": {
                  "$ref": "../../_common/farm_command_request.v1.json#/$defs/slug"
                },
                "period": {
                  "type": "array",
                  "items": {
                    "$ref": "../../_common/farm_command_request.v1.json#/$defs/period"
                  },
                  "minItems": 1,
                  "maxItems": 6,
                  "uniqueItems": true
                }
              },
              "required": [
                "client"
              ]
            }
          }
        }
      }
    }
  },
  "required": [
    "type",
    "kind",
    "domain",
    "subject",
    "schemaref",
    "dataschema",
    "command_id",
    "idempotency_key",
    "actor",
    "data",
    "delivery"
  ]
}
