{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/billing/cost.receive.json",
  "title": "Billing Cost Receive Command",
  "description": "Imperative request, from an authenticated Farm (client portal) operator through the command palette (Milkshake Story 10.3), that the billing authority read a client's vendor costs into its ledger (ms squeeze; a plan reads nothing it records, an apply calls the vendors and writes bois). Signed by the portal Worker (HMAC-SHA256, a farm-command-* key) and accepted by farm-command-bridge at POST /v1/commands; the consumer re-verifies the signature, checks the sender's per-client grant on its own ledger and answers with billing.farm_command.completed, .denied or .failed carrying this command_id. Recommended idempotency_key: 'billing.cost.receive:client:<client>:command:<command_id>'. See bloodbank/docs/event-naming.md (billing) and Milkshake docs/farm-commands.md section 14.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.billing.cost.receive"
    },
    "kind": {
      "const": "command"
    },
    "domain": {
      "const": "billing"
    },
    "subject": {
      "const": "bloodbank.cmd.billing.cost.receive"
    },
    "schemaref": {
      "const": "bloodbank.billing.cost.receive.v1"
    },
    "dataschema": {
      "const": "apicurio://holyfields/bloodbank.billing.cost.receive/versions/1"
    },
    "delivery": {
      "const": "single_consumer"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^billing\\.cost\\.receive:client:[a-z0-9]+(-[a-z0-9]+)*:command:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "data": {
      "allOf": [
        {
          "$ref": "../../_common/farm_command_request.v1.json#/$defs/palette_data"
        }
      ],
      "description": "Payload for bloodbank.billing.cost.receive.",
      "properties": {
        "request": {
          "allOf": [
            {
              "$ref": "../../_common/farm_command_request.v1.json#/$defs/palette_request"
            }
          ],
          "properties": {
            "subject": {
              "const": "bloodbank.cmd.billing.cost.receive"
            },
            "command": {
              "const": "squeeze"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "client": {
                  "$ref": "../../_common/farm_command_request.v1.json#/$defs/slug"
                },
                "period": {
                  "$ref": "../../_common/farm_command_request.v1.json#/$defs/period"
                },
                "date_from": {
                  "$ref": "../../_common/farm_command_request.v1.json#/$defs/day"
                },
                "date_to": {
                  "$ref": "../../_common/farm_command_request.v1.json#/$defs/day"
                },
                "vendor": {
                  "$ref": "../../_common/farm_command_request.v1.json#/$defs/slug"
                },
                "refresh": {
                  "$ref": "../../_common/farm_command_request.v1.json#/$defs/flag"
                }
              },
              "required": [
                "client"
              ],
              "oneOf": [
                {
                  "required": [
                    "period"
                  ],
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "date_from"
                        ]
                      },
                      {
                        "required": [
                          "date_to"
                        ]
                      }
                    ]
                  }
                },
                {
                  "required": [
                    "date_from",
                    "date_to"
                  ],
                  "not": {
                    "required": [
                      "period"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    }
  },
  "required": [
    "type",
    "kind",
    "domain",
    "subject",
    "schemaref",
    "dataschema",
    "command_id",
    "idempotency_key",
    "actor",
    "data",
    "delivery"
  ]
}
