{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/project/app_launch.recorded.json",
  "title": "Project App Launch Recorded Event (BB-34 candidate)",
  "description": "First source-reported actual app._ready native startup per persisted installation and authoritative iOS bundle/version/final build. Verification is scoped to documented source-local checks and server release comparison, not remote authentication of an offline occurrence; see the TOLT-99 provenance clarification in docs/contracts/bb-34-tolt-producers.md. Unknown channel never qualifies as TestFlight.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.project.app_launch.recorded"
    },
    "domain": {
      "const": "project"
    },
    "kind": {
      "const": "event"
    },
    "subject": {
      "const": "bloodbank.evt.project.app_launch.recorded"
    },
    "schemaref": {
      "const": "bloodbank.project.app_launch.recorded.v1"
    },
    "dataschema": {
      "const": "apicurio://holyfields/bloodbank.project.app_launch.recorded/versions/1"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "data": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "project": {
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "maxLength": 100
            }
          },
          "required": [
            "slug"
          ],
          "additionalProperties": false
        },
        "observed_at": {
          "$ref": "../../_common/types.v1.json#/$defs/timestamp",
          "pattern": "Z$"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "installation_id": {
          "$ref": "../../_common/types.v1.json#/$defs/uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "installation_id_origin": {
          "const": "persisted_csprng_uuid4"
        },
        "native_build": {
          "$ref": "../../_common/game_data.v1.json#/$defs/native_build"
        },
        "native_identity_source": {
          "const": "ios_bundle"
        },
        "final_native_identity_verified": {
          "const": true,
          "description": "Originating native code read the actual installed iOS tuple; the normalizer matched it to trusted final-build evidence for the same manifest. Not intended/Linux identity, distribution proof or remote runtime authentication."
        },
        "channel": {
          "enum": [
            "testflight",
            "app_store",
            "private_app",
            "unknown"
          ]
        },
        "testflight_eligible": {
          "type": "boolean"
        },
        "channel_evidence": {
          "type": "object",
          "properties": {
            "basis": {
              "enum": [
                "verified_testflight_runtime",
                "verified_other_distribution",
                "unverified",
                "sandbox_receipt_only"
              ]
            },
            "evidence_ref": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300,
                  "pattern": "^(?:urn:|repo://)"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "basis",
            "evidence_ref"
          ],
          "additionalProperties": false
        },
        "bundle_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Source hash of exact installed main-bundle Info.plist bytes; not an IPA/PCK hash or authentication. Publication requires a matching trusted final-artifact record using the same byte definition."
        },
        "installation_verified": {
          "const": true,
          "description": "The originating client positively checked CSPRNG UUID4 persistence/readback under the reviewed-source telemetry policy. The backend does not prove remote persistence, CSPRNG origin, physical-device uniqueness or authenticity from the POST."
        },
        "bundle_verified": {
          "const": true,
          "description": "Source read/hash of the running main-bundle manifest and automated server comparison with trusted exact final-artifact evidence succeeded. Hash syntax or a client assertion alone is insufficient; no remote installation authentication is claimed."
        },
        "native_boot_verified": {
          "const": true,
          "description": "The reviewed source capture path ran at actual non-debug iOS app._ready/APP_START with native bridge metadata available. This occurrence/time remain client-observed under the explicit telemetry trust model, not independently authenticated by the backend."
        },
        "provenance": {
          "type": "object",
          "properties": {
            "basis": {
              "const": "tolt_native_first_startup"
            },
            "record_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "pattern": "^(?:urn:|repo://)",
              "description": "Logical durable provenance record retaining original observation, reviewed source-policy/check scopes and trusted release comparison. It must distinguish client-observed runtime from server-compared evidence; URI syntax is not proof."
            }
          },
          "required": [
            "basis",
            "record_ref"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "project",
        "observed_at",
        "summary",
        "installation_id",
        "installation_id_origin",
        "native_build",
        "native_identity_source",
        "final_native_identity_verified",
        "channel",
        "testflight_eligible",
        "channel_evidence",
        "bundle_manifest_sha256",
        "installation_verified",
        "bundle_verified",
        "native_boot_verified",
        "provenance"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "channel": {
                "const": "testflight"
              }
            }
          },
          "then": {
            "properties": {
              "testflight_eligible": {
                "const": true
              },
              "channel_evidence": {
                "properties": {
                  "basis": {
                    "enum": [
                      "verified_testflight_runtime"
                    ]
                  },
                  "evidence_ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300,
                    "pattern": "^(?:urn:|repo://)"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "channel": {
                "const": "app_store"
              }
            }
          },
          "then": {
            "properties": {
              "testflight_eligible": {
                "const": false
              },
              "channel_evidence": {
                "properties": {
                  "basis": {
                    "enum": [
                      "verified_other_distribution"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "channel": {
                "const": "private_app"
              }
            }
          },
          "then": {
            "properties": {
              "testflight_eligible": {
                "const": false
              },
              "channel_evidence": {
                "properties": {
                  "basis": {
                    "enum": [
                      "verified_other_distribution"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "channel": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "testflight_eligible": {
                "const": false
              },
              "channel_evidence": {
                "properties": {
                  "basis": {
                    "enum": [
                      "unverified",
                      "sandbox_receipt_only"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "type",
    "domain",
    "kind",
    "subject",
    "schemaref",
    "dataschema",
    "datacontenttype",
    "actor",
    "ordering_key",
    "causationid",
    "data"
  ]
}
