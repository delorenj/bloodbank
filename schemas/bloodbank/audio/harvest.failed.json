{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/audio/harvest.failed.json",
  "title": "Audio Harvest Failed Event",
  "description": "A harvest stopped at a stage without finishing. Envelope correlationid is the start command's correlationid; causationid is the command_id that caused this event. ordering_key SHOULD be 'harvest:<wax_item_id or transcript_id>'.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.audio.harvest.failed"
    },
    "kind": {
      "const": "event"
    },
    "domain": {
      "const": "audio"
    },
    "data": {
      "type": "object",
      "description": "Payload for bloodbank.audio.harvest.failed.",
      "properties": {
        "transcript_id": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Wax transcript row id, when known."
        },
        "wax_item_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{16}$",
          "description": "Wax item id (16 hex), when known."
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "description": "Transcript title, when known."
        },
        "stage": {
          "type": "string",
          "enum": [
            "enrichment",
            "harvest",
            "publish"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "harvest_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "stage",
        "reason"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "type",
    "kind",
    "domain",
    "data"
  ]
}
