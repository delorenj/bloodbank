{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/audio/harvest.start.json",
  "title": "Audio Harvest Start Command",
  "description": "Imperative request to harvest ticketable items from one transcript (Holocene Transcripts tab 'Harvest' button). Consumed by the pilot harvest worker (px harvest worker), which answers audio.harvest.queued, started, then completed (review link) or failed. At least one of transcript_id / wax_item_id is required. Recommended idempotency_key: 'audio.harvest.start:<wax_item_id or transcript_id>'.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.audio.harvest.start"
    },
    "kind": {
      "const": "command"
    },
    "domain": {
      "const": "audio"
    },
    "delivery": {
      "const": "single_consumer"
    },
    "data": {
      "type": "object",
      "description": "Payload for bloodbank.audio.harvest.start.",
      "properties": {
        "transcript_id": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Wax transcript row id, when known."
        },
        "wax_item_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{16}$",
          "description": "Wax item id (16 hex), when known."
        },
        "requested_by": {
          "type": "string",
          "minLength": 1,
          "description": "Who asked, e.g. 'holocene'."
        },
        "force": {
          "type": "boolean",
          "default": false,
          "description": "Re-harvest even if a harvest already exists."
        }
      },
      "required": [
        "requested_by"
      ],
      "additionalProperties": true,
      "anyOf": [
        {
          "properties": {
            "transcript_id": {
              "type": "integer"
            }
          },
          "required": [
            "transcript_id"
          ]
        },
        {
          "properties": {
            "wax_item_id": {
              "type": "string"
            }
          },
          "required": [
            "wax_item_id"
          ]
        }
      ]
    }
  },
  "required": [
    "type",
    "kind",
    "domain",
    "data",
    "actor",
    "command_id",
    "idempotency_key",
    "delivery"
  ]
}
