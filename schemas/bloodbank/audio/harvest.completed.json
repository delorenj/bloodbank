{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/audio/harvest.completed.json",
  "title": "Audio Harvest Completed Event",
  "description": "A harvest is ready for review; data.review_url is the review form and data.links carries it as a notification button. Envelope correlationid is the start command's correlationid; causationid is the command_id that caused this event. ordering_key SHOULD be 'harvest:<wax_item_id or transcript_id>'.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.audio.harvest.completed"
    },
    "kind": {
      "const": "event"
    },
    "domain": {
      "const": "audio"
    },
    "data": {
      "type": "object",
      "description": "Payload for bloodbank.audio.harvest.completed.",
      "properties": {
        "transcript_id": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Wax transcript row id, when known."
        },
        "wax_item_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{16}$",
          "description": "Wax item id (16 hex), when known."
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "description": "Transcript title, when known."
        },
        "harvest_id": {
          "type": "string",
          "minLength": 1
        },
        "review_url": {
          "type": "string",
          "maxLength": 600,
          "pattern": "^https://[^\\s\"<>]+$"
        },
        "items": {
          "type": "integer",
          "minimum": 0,
          "description": "Total harvested items."
        },
        "clear": {
          "type": "integer",
          "minimum": 0,
          "description": "Items clear to publish."
        },
        "held": {
          "type": "integer",
          "minimum": 0,
          "description": "Items held for review."
        },
        "rejected": {
          "type": "integer",
          "minimum": 0,
          "description": "Items rejected."
        },
        "links": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "description": "Notification buttons, same {rel,label,url} convention as project.deployment.completed.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "rel": {
                "type": "string",
                "enum": [
                  "page"
                ],
                "description": "page: the review form."
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "url": {
                "type": "string",
                "maxLength": 600,
                "pattern": "^https://[^\\s\"<>]+$"
              }
            },
            "required": [
              "rel",
              "label",
              "url"
            ]
          }
        }
      },
      "required": [
        "harvest_id",
        "review_url",
        "items",
        "clear",
        "held",
        "rejected",
        "links"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "type",
    "kind",
    "domain",
    "data"
  ]
}
