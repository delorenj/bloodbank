{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/audio/harvest.published.json",
  "title": "Audio Harvest Published Event",
  "description": "A reviewed harvest was published as tickets. Envelope correlationid is the start command's correlationid; causationid is the command_id that caused this event. ordering_key SHOULD be 'harvest:<wax_item_id or transcript_id>'.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.audio.harvest.published"
    },
    "kind": {
      "const": "event"
    },
    "domain": {
      "const": "audio"
    },
    "data": {
      "type": "object",
      "description": "Payload for bloodbank.audio.harvest.published.",
      "properties": {
        "transcript_id": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Wax transcript row id, when known."
        },
        "wax_item_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{16}$",
          "description": "Wax item id (16 hex), when known."
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "description": "Transcript title, when known."
        },
        "harvest_id": {
          "type": "string",
          "minLength": 1
        },
        "created": {
          "type": "integer",
          "minimum": 0,
          "description": "Tickets created."
        },
        "adopted": {
          "type": "integer",
          "minimum": 0,
          "description": "Existing tickets adopted."
        },
        "failed": {
          "type": "integer",
          "minimum": 0,
          "description": "Items that failed to publish."
        },
        "tickets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "project_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "ref"
            ],
            "additionalProperties": true
          }
        }
      },
      "required": [
        "harvest_id",
        "created",
        "adopted",
        "failed",
        "tickets"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "type",
    "kind",
    "domain",
    "data"
  ]
}
