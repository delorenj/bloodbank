{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/audio/earshot.ended.json",
  "title": "Audio Earshot Ended Event",
  "description": "The phone played the sound file to the end (device phase 'finished'). Reported by the device through the upload proxy (POST /upload/heard); fail-open. Earshot is a bucket channel that plays on the phone: any sound file in s3://earshot/<channel>/... is read aloud. correlationid = data.event_id (uuid5 of s3://earshot/<key>), ordering_key 'earshot:<event_id>'. See bloodbank/docs/event-naming.md.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.audio.earshot.ended"
    },
    "kind": {
      "const": "event"
    },
    "domain": {
      "const": "audio"
    },
    "ordering_key": {
      "type": "string",
      "pattern": "^earshot:.+$"
    },
    "data": {
      "type": "object",
      "description": "Payload for bloodbank.audio.earshot.ended.",
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid",
          "description": "Drop id: uuid5(NAMESPACE_URL, 's3://earshot/' + key). Also the correlationid."
        },
        "channel": {
          "type": "string",
          "minLength": 1,
          "description": "First key segment of the object key."
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "description": "Object key in the earshot bucket."
        },
        "phase": {
          "type": "string",
          "enum": [
            "detected",
            "started",
            "finished",
            "failed",
            "missed"
          ],
          "description": "The device's own phase word."
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "description": "Device clock when the phase happened."
        },
        "last_modified": {
          "type": "string",
          "format": "date-time",
          "description": "Bucket LastModified of the object (when it was dropped)."
        },
        "device": {
          "type": "string",
          "minLength": 1
        },
        "app_version": {
          "type": "string",
          "minLength": 1
        },
        "error": {
          "type": [
            "string",
            "null"
          ],
          "description": "Failure/skip reason, if any."
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "client_user_agent": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "event_id",
        "channel",
        "key",
        "phase",
        "at",
        "last_modified",
        "device",
        "app_version"
      ]
    }
  },
  "required": [
    "type",
    "kind",
    "domain",
    "data"
  ]
}
