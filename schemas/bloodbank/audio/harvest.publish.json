{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/audio/harvest.publish.json",
  "title": "Audio Harvest Publish Command",
  "description": "Imperative request to publish a reviewed harvest as tickets (px harvest publish <artifact> --accepted). Fired by the harvest worker when the review form is submitted; consumed by the same worker. Answers audio.harvest.published or audio.harvest.failed (stage publish).",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.audio.harvest.publish"
    },
    "kind": {
      "const": "command"
    },
    "domain": {
      "const": "audio"
    },
    "delivery": {
      "const": "single_consumer"
    },
    "data": {
      "type": "object",
      "description": "Payload for bloodbank.audio.harvest.publish.",
      "properties": {
        "harvest_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_path": {
          "type": "string",
          "minLength": 1,
          "description": "Path of the harvest artifact to publish."
        },
        "transcript_id": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Wax transcript row id, when known."
        },
        "wax_item_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{16}$",
          "description": "Wax item id (16 hex), when known."
        },
        "accepted_only": {
          "type": "boolean",
          "description": "Publish only items the reviewer accepted (--accepted)."
        },
        "general_to": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional board/project that receives general (unrouted) items."
        },
        "requested_by": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "harvest_id",
        "artifact_path",
        "accepted_only",
        "requested_by"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "type",
    "kind",
    "domain",
    "data",
    "actor",
    "command_id",
    "idempotency_key",
    "delivery"
  ]
}
