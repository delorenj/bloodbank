{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/audio/memo.transcribed.json",
  "title": "Audio Memo Transcribed Event",
  "description": "The voice memo audio was transcribed to text. Part of the voice memo journey: every stage fact and the agent invocation share correlationid = data.memo_id and ordering_key 'memo:<memo_id>'. See bloodbank/docs/event-naming.md.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.audio.memo.transcribed"
    },
    "kind": {
      "const": "event"
    },
    "domain": {
      "const": "audio"
    },
    "data": {
      "type": "object",
      "description": "Payload for bloodbank.audio.memo.transcribed.",
      "properties": {
        "memo_id": {
          "type": "string",
          "format": "uuid",
          "description": "Journey id: uuid5(NAMESPACE_URL, 's3://holocene-auto/' + s3_key). Also the correlationid of this event and of the agent invocation command, so one correlationid query returns the whole journey."
        },
        "s3_key": {
          "type": "string",
          "minLength": 1,
          "description": "Object key of the voice memo in the holocene-auto bucket: inbox/<agent>/<yyyy>/<mm>/<dd>/<file>."
        },
        "target_agent_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Agent the memo is addressed to. Parsed from the S3 key path only, never inferred from audio."
        },
        "transcript_text": {
          "type": "string",
          "description": "The transcript that becomes the agent prompt."
        },
        "transcript_chars": {
          "type": "integer",
          "minimum": 0
        },
        "word_count": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Words in the transcript.",
          "minimum": 0
        },
        "audio_duration_seconds": {
          "type": [
            "number",
            "null"
          ],
          "description": "Length of the recorded audio.",
          "minimum": 0
        },
        "processing_seconds": {
          "type": [
            "number",
            "null"
          ],
          "description": "Wall time spent transcribing, including GPU wait and model load.",
          "minimum": 0
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "description": "Speech model name."
        },
        "backend": {
          "type": [
            "string",
            "null"
          ],
          "description": "Speech engine backend."
        },
        "language": {
          "type": [
            "string",
            "null"
          ],
          "description": "Detected language code."
        }
      },
      "required": [
        "memo_id",
        "s3_key",
        "target_agent_id",
        "transcript_text"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "type",
    "kind",
    "domain",
    "data"
  ]
}
