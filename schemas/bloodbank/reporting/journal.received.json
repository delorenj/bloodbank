{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/reporting/journal.received.json",
  "title": "Reporting Journal Received Event",
  "description": "The n8n journal ingress durably stored one report completion event for processing.",
  "type": "object",
  "allOf": [{"$ref": "../../_common/cloudevent_base.v1.json"}],
  "properties": {
    "type": {"const": "bloodbank.reporting.journal.received"},
    "kind": {"const": "event"},
    "domain": {"const": "reporting"},
    "subject": {"const": "bloodbank.evt.reporting.journal.received"},
    "datacontenttype": {"const": "application/json"},
    "dataschema": {"const": "apicurio://holyfields/bloodbank.reporting.journal.received/versions/1"},
    "schemaref": {"const": "bloodbank.reporting.journal.received.v1"},
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_event_id": {"$ref": "../../_common/types.v1.json#/$defs/uuid"},
        "report_date": {"type": "string", "format": "date"},
        "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "generation_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
        "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "received_at": {"$ref": "../../_common/types.v1.json#/$defs/timestamp"}
      },
      "required": ["source_event_id", "report_date", "run_id", "generation_id", "content_sha256", "received_at"]
    }
  },
  "required": ["specversion", "id", "source", "type", "subject", "time", "datacontenttype", "dataschema", "correlationid", "causationid", "producer", "service", "kind", "domain", "schemaref", "actor", "ordering_key", "data"]
}
