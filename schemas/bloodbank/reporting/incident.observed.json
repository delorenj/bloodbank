{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/reporting/incident.observed.json",
  "title": "Reporting Incident Observed Event",
  "description": "One dated observation of a recurring or newly detected problem in a developer report.",
  "type": "object",
  "allOf": [{"$ref": "../../_common/cloudevent_base.v1.json"}],
  "properties": {
    "type": {"const": "bloodbank.reporting.incident.observed"},
    "kind": {"const": "event"},
    "domain": {"const": "reporting"},
    "subject": {"const": "bloodbank.evt.reporting.incident.observed"},
    "datacontenttype": {"const": "application/json"},
    "dataschema": {"const": "apicurio://holyfields/bloodbank.reporting.incident.observed/versions/1"},
    "schemaref": {"const": "bloodbank.reporting.incident.observed.v1"},
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "occurrence_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "fingerprint": {"type": "string", "minLength": 1, "maxLength": 128},
        "report_date": {"type": "string", "format": "date"},
        "project_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "area": {"type": "string", "minLength": 1, "maxLength": 128},
        "failure_mode": {"type": "string", "minLength": 1, "maxLength": 256},
        "status": {"enum": ["open", "resolved"]},
        "severity": {"enum": ["low", "medium", "high", "critical"]},
        "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
        "evidence": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
        "source_event_id": {"$ref": "../../_common/types.v1.json#/$defs/uuid"},
        "observed_at": {"$ref": "../../_common/types.v1.json#/$defs/timestamp"},
        "ticket_key": {"type": "string", "minLength": 1, "maxLength": 64}
      },
      "required": ["occurrence_id", "fingerprint", "report_date", "project_id", "area", "failure_mode", "status", "severity", "summary", "evidence", "source_event_id", "observed_at"]
    }
  },
  "required": ["specversion", "id", "source", "type", "subject", "time", "datacontenttype", "dataschema", "correlationid", "causationid", "producer", "service", "kind", "domain", "schemaref", "actor", "ordering_key", "data"]
}
