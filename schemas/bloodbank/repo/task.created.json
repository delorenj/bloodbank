{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/repo/task.created.json",
  "title": "Repo Task Created Event",
  "description": "A ticket provider or PM created a repo-scoped task. The repo slug and provider provenance belong in data, not in the CloudEvents type.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.repo.task.created"
    },
    "kind": {
      "const": "event"
    },
    "domain": {
      "const": "repo"
    },
    "data": {
      "type": "object",
      "description": "Payload for bloodbank.repo.task.created.",
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "task_id": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "assignee": {
          "type": "string"
        },
        "slug": {
          "type": "string",
          "minLength": 1,
          "description": "Canonical project slug; normally identical to repo."
        },
        "workspace": {
          "type": "string",
          "minLength": 1
        },
        "board_id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "ticket_id": {
          "type": "string",
          "minLength": 1
        },
        "ticket_key": {
          "type": ["string", "null"]
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "provider_event_type": {
          "type": "string",
          "minLength": 1,
          "description": "Provider provenance name, for example plane.ticket.created."
        },
        "phase": {
          "type": ["string", "null"]
        },
        "tp_band": {
          "type": ["string", "null"]
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "ticket": {
          "type": "object",
          "description": "Lossless JSON ticket entity supplied by the provider.",
          "additionalProperties": true
        }
      },
      "required": [
        "repo",
        "title"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "type",
    "kind",
    "domain",
    "data"
  ]
}
