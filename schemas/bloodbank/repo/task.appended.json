{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/repo/task.appended.json",
  "title": "Repo Task Appended Event",
  "description": "A comment or other append-only note was added to a provider-neutral repo task.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.repo.task.appended"
    },
    "kind": {
      "const": "event"
    },
    "domain": {
      "const": "repo"
    },
    "data": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "workspace": {
          "type": "string",
          "minLength": 1
        },
        "board_id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "ticket_id": {
          "type": "string",
          "minLength": 1
        },
        "ticket_key": {
          "type": ["string", "null"]
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "provider_event_type": {
          "type": "string",
          "minLength": 1,
          "description": "Provider provenance name, for example plane.ticket.commented."
        },
        "comment_id": {
          "type": "string",
          "minLength": 1
        },
        "author_id": {
          "type": ["string", "null"]
        },
        "body": {
          "type": "string"
        },
        "appended_at": {
          "type": "string",
          "format": "date-time"
        },
        "comment": {
          "type": "object",
          "description": "Lossless JSON comment entity supplied by the provider.",
          "additionalProperties": true
        }
      },
      "required": [
        "repo",
        "slug",
        "workspace",
        "board_id",
        "project_id",
        "ticket_id",
        "provider",
        "provider_event_type",
        "comment_id",
        "body",
        "appended_at",
        "comment"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "type",
    "kind",
    "domain",
    "data"
  ]
}
