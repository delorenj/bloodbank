{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/repo/task.updated.json",
  "title": "Repo Task Updated Event",
  "description": "A provider-neutral repo task changed. Provider provenance and the lossless ticket entity live in data.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.repo.task.updated"
    },
    "kind": {
      "const": "event"
    },
    "domain": {
      "const": "repo"
    },
    "data": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "workspace": {
          "type": "string",
          "minLength": 1
        },
        "board_id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "ticket_id": {
          "type": "string",
          "minLength": 1
        },
        "ticket_key": {
          "type": ["string", "null"]
        },
        "title": {
          "type": ["string", "null"]
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "provider_event_type": {
          "type": "string",
          "minLength": 1,
          "description": "Provider provenance name, for example plane.ticket.transitioned."
        },
        "previous_phase": {
          "type": ["string", "null"]
        },
        "phase": {
          "type": ["string", "null"]
        },
        "previous_tp_band": {
          "type": ["string", "null"]
        },
        "tp_band": {
          "type": ["string", "null"]
        },
        "changed_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "trigger_source": {
          "type": ["string", "null"]
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "ticket": {
          "type": "object",
          "description": "Lossless JSON ticket entity supplied by the provider.",
          "additionalProperties": true
        }
      },
      "required": [
        "repo",
        "slug",
        "workspace",
        "board_id",
        "project_id",
        "ticket_id",
        "provider",
        "provider_event_type",
        "changed_fields",
        "timestamp",
        "ticket"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "type",
    "kind",
    "domain",
    "data"
  ]
}
