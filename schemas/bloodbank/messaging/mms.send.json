{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/messaging/mms.send.json",
  "title": "Messaging MMS Send Command",
  "description": "Imperative request to send an mms text from one of the operator's Telnyx numbers. The executor answers with messaging.mms.sent (accepted) and then messaging.mms.completed or messaging.mms.failed, carrying this command_id. Telnyx long codes need 10DLC registration to reach US mobiles (error 40010 otherwise). Recommended idempotency_key: 'messaging.mms.send:<to>:<sha256(text)>:<minute>'. See bloodbank/docs/event-naming.md (messaging).",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.messaging.mms.send"
    },
    "kind": {
      "const": "command"
    },
    "domain": {
      "const": "messaging"
    },
    "delivery": {
      "const": "single_consumer"
    },
    "data": {
      "type": "object",
      "description": "Payload for bloodbank.messaging.mms.send.",
      "properties": {
        "to": {
          "type": "string",
          "description": "Destination (E.164).",
          "pattern": "^\\+[1-9][0-9]{6,14}$"
        },
        "text": {
          "type": "string",
          "description": "Message body.",
          "minLength": 1,
          "maxLength": 1600
        },
        "from": {
          "type": [
            "string",
            "null"
          ],
          "description": "Sending Telnyx number (E.164); null uses the default line.",
          "pattern": "^\\+[1-9][0-9]{6,14}$"
        },
        "media_urls": {
          "type": "array",
          "description": "Public URLs to send as MMS.",
          "items": {
            "type": "string",
            "description": "Media URL."
          }
        }
      },
      "required": [
        "to",
        "text",
        "media_urls"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "type",
    "kind",
    "domain",
    "data",
    "delivery"
  ]
}
