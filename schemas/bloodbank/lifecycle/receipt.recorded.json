{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/lifecycle/receipt.recorded.json",
  "title": "Execution v2 receipt recorded",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "type": "object",
  "properties": {
    "type": {
      "const": "bloodbank.lifecycle.receipt.recorded"
    },
    "domain": {
      "const": "lifecycle"
    },
    "kind": {
      "const": "event"
    },
    "data": {
      "type": "object",
      "properties": {
        "version": {
          "const": 2
        },
        "status": {
          "type": "string"
        },
        "command_id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "ticket_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "runtime_id": {
          "type": "string",
          "minLength": 1
        },
        "generation": {
          "type": "integer"
        }
      },
      "required": [
        "version",
        "status",
        "command_id",
        "project_id",
        "ticket_id",
        "run_id",
        "runtime_id",
        "generation"
      ]
    },
    "schemaref": {
      "const": "bloodbank.lifecycle.receipt.recorded.v2"
    },
    "dataschema": {
      "const": "apicurio://holyfields/bloodbank.lifecycle.receipt.recorded/versions/2"
    }
  },
  "required": [
    "type",
    "kind",
    "domain",
    "data",
    "actor",
    "subject",
    "datacontenttype",
    "dataschema",
    "schemaref",
    "causationid"
  ]
}
