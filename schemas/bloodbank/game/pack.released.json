{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/game/pack.released.json",
  "title": "Game Pack Released Event (BB-34 candidate)",
  "description": "One exact immutable pack version actually playable after catalog, PCK digest, exact version metadata and player readback; not upload, registration or deployment.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.game.pack.released"
    },
    "kind": {
      "const": "event"
    },
    "domain": {
      "const": "game"
    },
    "subject": {
      "const": "bloodbank.evt.game.pack.released"
    },
    "schemaref": {
      "const": "bloodbank.game.pack.released.v1"
    },
    "dataschema": {
      "const": "apicurio://holyfields/bloodbank.game.pack.released/versions/1"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "source": {
      "type": "string",
      "pattern": "^(?:urn:|repo://)"
    },
    "ordering_key": {
      "type": "string",
      "pattern": "^game:"
    },
    "data": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "project_slug": {
          "$ref": "../../_common/game_data.v1.json#/$defs/slug"
        },
        "observed_at": {
          "$ref": "../../_common/game_data.v1.json#/$defs/observed_at"
        },
        "correlation_id": {
          "$ref": "../../_common/types.v1.json#/$defs/uuid"
        },
        "cause_event_id": {
          "oneOf": [
            {
              "$ref": "../../_common/types.v1.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "provenance": {
          "allOf": [
            {
              "$ref": "../../_common/game_data.v1.json#/$defs/provenance"
            },
            {
              "properties": {
                "basis": {
                  "const": "tolt_pack_readback"
                },
                "source_commit": {
                  "type": "string",
                  "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
                }
              }
            }
          ]
        },
        "pack": {
          "$ref": "../../_common/game_data.v1.json#/$defs/pack"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "source_ticket": {
          "oneOf": [
            {
              "$ref": "../../_common/types.v1.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_job": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 160
        },
        "changelog": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "release_kind": {
          "enum": [
            "initial",
            "update"
          ]
        },
        "playable_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "format": "uri",
          "pattern": "^https://"
        },
        "catalog_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "game_commit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "verification": {
          "type": "object",
          "properties": {
            "catalog_verified": {
              "const": true
            },
            "exact_version_verified": {
              "const": true
            },
            "artifact_verified": {
              "const": true
            },
            "player_assets_verified": {
              "const": true
            },
            "load_verified": {
              "const": true
            }
          },
          "required": [
            "catalog_verified",
            "exact_version_verified",
            "artifact_verified",
            "player_assets_verified",
            "load_verified"
          ],
          "additionalProperties": false
        },
        "channels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "properties": {
              "channel": {
                "enum": [
                  "web",
                  "private_app",
                  "testflight"
                ]
              },
              "verified": {
                "const": true
              },
              "evidence_ref": {
                "$ref": "../../_common/game_data.v1.json#/$defs/record_ref"
              },
              "native_build": {
                "oneOf": [
                  {
                    "$ref": "../../_common/game_data.v1.json#/$defs/native_build"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "channel",
              "verified",
              "evidence_ref",
              "native_build"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "channel": {
                      "const": "web"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "native_build": {
                      "type": "null"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "native_build": {
                      "$ref": "../../_common/game_data.v1.json#/$defs/native_build"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "required": [
        "schema_version",
        "project_slug",
        "observed_at",
        "correlation_id",
        "cause_event_id",
        "summary",
        "provenance",
        "pack",
        "title",
        "source_ticket",
        "source_job",
        "changelog",
        "release_kind",
        "playable_url",
        "catalog_revision",
        "game_commit",
        "verification",
        "channels"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "type",
    "kind",
    "domain",
    "subject",
    "schemaref",
    "dataschema",
    "datacontenttype",
    "ordering_key",
    "actor",
    "causationid",
    "data"
  ]
}
