{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/game/item.created.json",
  "title": "Game Item Created Event (BB-34 candidate)",
  "description": "One new ready Thing durably landed in content main. Stable item identity survives retries and later art/name edits. Ready content does not imply candidate approval or a live prize-pool entry. Candidate pending scout and producer-owner reconciliation; see docs/contracts/bb-34-tolt-producers.md.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.game.item.created"
    },
    "kind": {
      "const": "event"
    },
    "domain": {
      "const": "game"
    },
    "subject": {
      "const": "bloodbank.evt.game.item.created"
    },
    "schemaref": {
      "const": "bloodbank.game.item.created.v1"
    },
    "dataschema": {
      "const": "apicurio://holyfields/bloodbank.game.item.created/versions/1"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "source": {
      "type": "string",
      "pattern": "^(?:urn:|repo://)"
    },
    "ordering_key": {
      "type": "string",
      "pattern": "^game:"
    },
    "data": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "project_slug": {
          "$ref": "../../_common/game_data.v1.json#/$defs/slug"
        },
        "observed_at": {
          "$ref": "../../_common/game_data.v1.json#/$defs/observed_at"
        },
        "correlation_id": {
          "$ref": "../../_common/types.v1.json#/$defs/uuid"
        },
        "cause_event_id": {
          "oneOf": [
            {
              "$ref": "../../_common/types.v1.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "provenance": {
          "allOf": [
            {
              "$ref": "../../_common/game_data.v1.json#/$defs/provenance"
            },
            {
              "properties": {
                "basis": {
                  "const": "forge_item_landed"
                },
                "source_commit": {
                  "type": "string",
                  "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
                }
              }
            }
          ]
        },
        "item_id": {
          "$ref": "../../_common/game_data.v1.json#/$defs/slug"
        },
        "item_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "content_status": {
          "const": "ready"
        },
        "registry_status": {
          "enum": [
            "not_observed",
            "candidate",
            "approved",
            "rejected",
            "live"
          ]
        },
        "item_sha256": {
          "$ref": "../../_common/game_data.v1.json#/$defs/sha256"
        },
        "art_sha256": {
          "$ref": "../../_common/game_data.v1.json#/$defs/sha256"
        },
        "request_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^req-[0-9]+$",
          "maxLength": 40
        }
      },
      "required": [
        "schema_version",
        "project_slug",
        "observed_at",
        "correlation_id",
        "cause_event_id",
        "summary",
        "provenance",
        "item_id",
        "item_name",
        "content_status",
        "registry_status",
        "item_sha256",
        "art_sha256",
        "request_id"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "type",
    "kind",
    "domain",
    "subject",
    "schemaref",
    "dataschema",
    "datacontenttype",
    "ordering_key",
    "actor",
    "causationid",
    "data"
  ]
}
