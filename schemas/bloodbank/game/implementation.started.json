{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/game/implementation.started.json",
  "title": "Game Implementation Started Event (BB-34 candidate)",
  "description": "Once per canonical new-game implementation claim after preparation and the actual build phase transition. Not reservation, ideation, revision, retry or arbitrary tool start. Candidate pending scout and producer-owner reconciliation; see docs/contracts/bb-34-tolt-producers.md.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.game.implementation.started"
    },
    "kind": {
      "const": "event"
    },
    "domain": {
      "const": "game"
    },
    "subject": {
      "const": "bloodbank.evt.game.implementation.started"
    },
    "schemaref": {
      "const": "bloodbank.game.implementation.started.v1"
    },
    "dataschema": {
      "const": "apicurio://holyfields/bloodbank.game.implementation.started/versions/1"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "source": {
      "type": "string",
      "pattern": "^(?:urn:|repo://)"
    },
    "ordering_key": {
      "type": "string",
      "pattern": "^game:"
    },
    "data": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "project_slug": {
          "$ref": "../../_common/game_data.v1.json#/$defs/slug"
        },
        "observed_at": {
          "$ref": "../../_common/game_data.v1.json#/$defs/observed_at"
        },
        "correlation_id": {
          "$ref": "../../_common/types.v1.json#/$defs/uuid"
        },
        "cause_event_id": {
          "oneOf": [
            {
              "$ref": "../../_common/types.v1.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "provenance": {
          "allOf": [
            {
              "$ref": "../../_common/game_data.v1.json#/$defs/provenance"
            },
            {
              "properties": {
                "basis": {
                  "const": "forge_build_phase_running"
                }
              }
            }
          ]
        },
        "implementation_id": {
          "$ref": "../../_common/types.v1.json#/$defs/uuid"
        },
        "job_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "concept_id": {
          "$ref": "../../_common/types.v1.json#/$defs/uuid"
        },
        "milestone": {
          "const": "build_started"
        },
        "game_kind": {
          "const": "new_game"
        }
      },
      "required": [
        "schema_version",
        "project_slug",
        "observed_at",
        "correlation_id",
        "cause_event_id",
        "summary",
        "provenance",
        "implementation_id",
        "job_id",
        "concept_id",
        "milestone",
        "game_kind"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "type",
    "kind",
    "domain",
    "subject",
    "schemaref",
    "dataschema",
    "datacontenttype",
    "ordering_key",
    "actor",
    "causationid",
    "data"
  ]
}
