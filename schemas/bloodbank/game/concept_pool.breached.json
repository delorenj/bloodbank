{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/bloodbank/game/concept_pool.breached.json",
  "title": "Game Concept Pool Breached Event (BB-34 candidate)",
  "description": "Projection of the existing Forge low-water UUID4 episode, not another pool evaluator. Zero is low; unknown is not zero; only a complete observation above five rearms the source. Candidate pending scout and producer-owner reconciliation; see docs/contracts/bb-34-tolt-producers.md.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/cloudevent_base.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "bloodbank.game.concept_pool.breached"
    },
    "kind": {
      "const": "event"
    },
    "domain": {
      "const": "game"
    },
    "subject": {
      "const": "bloodbank.evt.game.concept_pool.breached"
    },
    "schemaref": {
      "const": "bloodbank.game.concept_pool.breached.v1"
    },
    "dataschema": {
      "const": "apicurio://holyfields/bloodbank.game.concept_pool.breached/versions/1"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "source": {
      "type": "string",
      "pattern": "^(?:urn:|repo://)"
    },
    "ordering_key": {
      "type": "string",
      "pattern": "^game:"
    },
    "data": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "project_slug": {
          "$ref": "../../_common/game_data.v1.json#/$defs/slug"
        },
        "observed_at": {
          "$ref": "../../_common/game_data.v1.json#/$defs/observed_at"
        },
        "correlation_id": {
          "$ref": "../../_common/types.v1.json#/$defs/uuid"
        },
        "cause_event_id": {
          "oneOf": [
            {
              "$ref": "../../_common/types.v1.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "provenance": {
          "allOf": [
            {
              "$ref": "../../_common/game_data.v1.json#/$defs/provenance"
            },
            {
              "properties": {
                "basis": {
                  "const": "forge_low_water_episode"
                }
              }
            }
          ]
        },
        "pool_id": {
          "$ref": "../../_common/game_data.v1.json#/$defs/slug"
        },
        "episode_id": {
          "$ref": "../../_common/types.v1.json#/$defs/uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "episode_schema": {
          "const": "ltf.concept-low-water/1"
        },
        "eligible_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "threshold": {
          "const": 5
        },
        "complete": {
          "const": true
        }
      },
      "required": [
        "schema_version",
        "project_slug",
        "observed_at",
        "correlation_id",
        "cause_event_id",
        "summary",
        "provenance",
        "pool_id",
        "episode_id",
        "episode_schema",
        "eligible_count",
        "threshold",
        "complete"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "type",
    "kind",
    "domain",
    "subject",
    "schemaref",
    "dataschema",
    "datacontenttype",
    "ordering_key",
    "actor",
    "causationid",
    "data"
  ]
}
